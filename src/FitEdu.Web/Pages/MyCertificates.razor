@page "/my-certificates"
@attribute [Authorize(Roles = "Student")]
@using System.Globalization

<PageTitle>@CertificateRes.PageTitle</PageTitle>

<div class="page certificates-page">
    <header class="certificates-head">
        <span class="eyebrow"><span class="bi @AppIcons.Certificate" aria-hidden="true"></span> @NavMenuRes.Certificates</span>
        <h1>@CertificateRes.Heading</h1>
        <p class="certificates-head__lead">@CertificateRes.Subtitle</p>
    </header>

    @if (_loading)
    {
        <LoadingSpinner Label="@CertificateRes.Loading" />
    }
    else if (_certificates is null || _certificates.Count == 0)
    {
        <EmptyState Icon="@AppIcons.Certificate"
                    Title="@CertificateRes.NoCertificates"
                    ActionHref="/courses"
                    ActionLabel="@CertificateRes.BrowseCourses" />
    }
    else
    {
        <ul class="grid-auto certificate-grid">
            @foreach (var cert in _certificates)
            {
                // The machine-readable date and the shown date are the same local day.
                var issuedLocal = cert.IssuedAt.ToLocalTime();
                <li class="card-surface certificate-card" @key="cert.Id">
                    <div class="certificate-card__band">
                        <span class="certificate-card__seal" aria-hidden="true"><span class="bi bi-award-fill"></span></span>
                        <span class="eyebrow">@CertificateRes.CardEyebrow</span>
                    </div>

                    <div class="card-surface__body certificate-card__body">
                        <h2 class="certificate-card__title">@cert.CourseTitle</h2>

                        <dl class="certificate-card__facts">
                            <div>
                                <dt>@CertificateRes.FieldIssuedOn</dt>
                                <dd><time datetime="@issuedLocal.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@issuedLocal.ToString("d MMMM yyyy", CultureInfo.CurrentCulture)</time></dd>
                            </div>
                            <div>
                                <dt>@CertificateRes.FieldVerificationId</dt>
                                <dd class="certificate-card__id">@cert.VerificationId</dd>
                            </div>
                        </dl>

                        <div class="certificate-card__actions">
                            @* PERF-5: download straight from the API over HTTP (same-origin cookie auth)
                               instead of pulling the PDF bytes through the SignalR circuit. *@
                            <a class="btn-cta"
                               href="/api/certificates/@cert.Id/download"
                               target="_blank"
                               rel="noopener noreferrer">
                                <span class="bi bi-download" aria-hidden="true"></span>
                                @CertificateRes.DownloadPdf
                            </a>
                            <a class="btn-cta btn-cta--ghost"
                               href="/certificate/@cert.VerificationId"
                               target="_blank"
                               rel="noopener noreferrer">
                                <span class="bi bi-shield-check" aria-hidden="true"></span>
                                @CertificateRes.Verify
                            </a>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }

    <DismissibleAlert Message="@_error" AlertType="danger" OnDismiss="@(() => _error = string.Empty)" />
</div>
