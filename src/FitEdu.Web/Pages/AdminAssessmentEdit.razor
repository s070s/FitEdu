@page "/admin/assessments/new"
@page "/admin/assessments/{AssessmentId:guid}/edit"
@using FitEdu.Web.Shared
@attribute [Authorize(Roles = "Admin")]

<PageTitle>@(IsNew ? AdminRes.CreateAssessment : AdminRes.EditAssessment)</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2">@(IsNew ? AdminRes.CreateAssessment : AdminRes.EditAssessment)</h1>
    <button class="btn btn-secondary" @onclick="GoBack">@AdminRes.BackToAssessments</button>
</div>

<DismissibleAlert Message="@message" AlertType="@messageType" OnDismiss="@(() => message = string.Empty)" />

<UnsavedChangesGuard IsDirty="_isDirty" />

@if (!IsNew && loading)
{
    <LoadingSpinner Label="@AdminRes.Loading" />
}
else
{
    <div @oninput="MarkDirty" @onchange="MarkDirty">
    <FormCardSection Title="@AdminRes.AssessmentDetails">
        <ChildContent>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">@AdminRes.FieldKey <small class="text-light-muted">(@AdminRes.FieldKeyHint)</small></label>
                    <input class="form-control" @bind="assessmentKey" placeholder="my_assessment_v1" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">@AdminRes.FieldTitle (EN)</label>
                    <input class="form-control" @bind="assessmentTitleEn" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">@AdminRes.FieldTitle (EL)</label>
                    <input class="form-control" @bind="assessmentTitleEl" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">@AdminRes.FieldDescription (EN)</label>
                <QuillEditor @ref="descriptionEditorEn" Content="@assessmentDescriptionEn" MinHeight="120px" />
            </div>
            <div class="mb-3">
                <label class="form-label">@AdminRes.FieldDescription (EL)</label>
                <QuillEditor @ref="descriptionEditorEl" Content="@assessmentDescriptionEl" MinHeight="120px" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="assessment-category">@CategoryRes.CategoryLabel</label>
                <select id="assessment-category" class="form-select" value="@CategorySelectValue" @onchange="OnCategorySelectChanged">
                    <option value="none">@CategoryRes.NoneCategory</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.NameEn</option>
                    }
                    <option value="new">@CategoryRes.NewCategoryOption</option>
                </select>
                @if (creatingNewCategory)
                {
                    <input class="form-control mt-2" placeholder="@CategoryRes.NewCategoryNamePlaceholder" @bind="newCategoryName" />
                }
            </div>
        </ChildContent>
    </FormCardSection>

    <FormCardSection Title="@AdminRes.Questions">
        <HeaderActions>
            <button class="btn btn-sm btn-success" @onclick="AddSection">@AdminRes.AddSection</button>
        </HeaderActions>
        <ChildContent>
            @for (var s = 0; s < schema.Sections.Count; s++)
            {
                var section = schema.Sections[s];
                var sectionNumber = s + 1;

                <div class="card mb-4" @key="section.TempId">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>@string.Format(AdminRes.SectionNumber, sectionNumber)</strong>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveSection(section)" title="@AdminRes.Remove" aria-label="@AdminRes.Remove"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">@AdminRes.FieldTitle (EN)</label>
                                <input class="form-control form-control-sm" @bind="section.TitleEn" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@AdminRes.FieldTitle (EL)</label>
                                <input class="form-control form-control-sm" @bind="section.TitleEl" />
                            </div>
                        </div>

                        @if (section.Questions.Count == 0)
                        {
                            <p class="text-light-muted">@AdminRes.NoQuestions</p>
                        }

                        @for (var i = 0; i < section.Questions.Count; i++)
                        {
                            var q = section.Questions[i];
                            var index = i;
                            var isExpanded = _expandedQuestions.Contains(q.TempId);
                            var labelPreview = string.IsNullOrWhiteSpace(q.LabelEn)
                                ? "(no label)"
                                : (q.LabelEn.Length > 60 ? q.LabelEn[..60] + "…" : q.LabelEn);

                            <div class="card mb-3 border-start border-primary border-3" @key="q.TempId">
                                <div class="card-header d-flex justify-content-between align-items-center collapsible-header"
                                     role="button"
                                     aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                                     @onclick="() => ToggleQuestion(q.TempId)">
                                    <div class="d-flex flex-column">
                                        <strong>@string.Format(AdminRes.QuestionNumber, index + 1)</strong>
                                        <small class="text-light-muted">@labelPreview</small>
                                    </div>
                                    <div class="d-flex align-items-center gap-2" @onclick:stopPropagation="true">
                                        @if (index > 0)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => MoveQuestion(section, index, -1)" title="@AdminRes.MoveUp">↑</button>
                                        }
                                        @if (index < section.Questions.Count - 1)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => MoveQuestion(section, index, 1)" title="@AdminRes.MoveDown">↓</button>
                                        }
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveQuestion(section, index)" title="@AdminRes.Remove" aria-label="@AdminRes.Remove"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
                                        <i class="bi bi-chevron-down chevron-icon @(isExpanded ? "expanded" : "")"></i>
                                    </div>
                                </div>
                                <div class="collapsible-body-wrapper @(isExpanded ? "expanded" : "collapsed")">
                                    <div class="collapsible-body-inner">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-6 mb-2">
                                                    <label class="form-label">@AdminRes.QuestionId</label>
                                                    <input class="form-control form-control-sm" @bind="q.Id" placeholder="q1" />
                                                </div>
                                                <div class="col-md-3 mb-2">
                                                    <label class="form-label">@AdminRes.FieldType</label>
                                                    <select class="form-select form-select-sm" @bind="q.Type">
                                                        @foreach (var typeOption in TypeOptions(q.Type))
                                                        {
                                                            <option value="@typeOption.Value">@typeOption.Label</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3 mb-2">
                                                    <label class="form-label">@AdminRes.FieldRequired</label>
                                                    <select class="form-select form-select-sm" @bind="q.RequiredText">
                                                        <option value="true">@AdminRes.Yes</option>
                                                        <option value="false">@AdminRes.No</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="row mb-2">
                                                <div class="col-md-6">
                                                    <label class="form-label">@AdminRes.QuestionLabel (EN)</label>
                                                    <input class="form-control form-control-sm" @bind="q.LabelEn" placeholder="@AdminRes.QuestionLabelPlaceholder" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">@AdminRes.QuestionLabel (EL)</label>
                                                    <input class="form-control form-control-sm" @bind="q.LabelEl" />
                                                </div>
                                            </div>

                                            @if (q.IsRatingScale)
                                            {
                                                <div class="row">
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label">@AdminRes.FieldMin</label>
                                                        <input type="number" class="form-control form-control-sm" @bind="q.Min" />
                                                    </div>
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label">@AdminRes.FieldMax</label>
                                                        <input type="number" class="form-control form-control-sm" @bind="q.Max" />
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label">@AdminRes.FieldMinLabel (EN)</label>
                                                        <input class="form-control form-control-sm" @bind="q.MinLabelEn" />
                                                    </div>
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label">@AdminRes.FieldMaxLabel (EN)</label>
                                                        <input class="form-control form-control-sm" @bind="q.MaxLabelEn" />
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label">@AdminRes.FieldMinLabel (EL)</label>
                                                        <input class="form-control form-control-sm" @bind="q.MinLabelEl" />
                                                    </div>
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label">@AdminRes.FieldMaxLabel (EL)</label>
                                                        <input class="form-control form-control-sm" @bind="q.MaxLabelEl" />
                                                    </div>
                                                </div>
                                            }

                                            @if (q.HasOptions)
                                            {
                                                <div class="row mb-2">
                                                    <div class="col-md-6">
                                                        <label class="form-label">@AdminRes.FieldOptions (EN) <small class="text-light-muted">(@AdminRes.FieldOptionsHint)</small></label>
                                                        <textarea class="form-control form-control-sm" rows="4"
                                                                  @bind="q.OptionsTextEn"
                                                                  placeholder="Option 1&#10;Option 2&#10;Option 3"></textarea>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">@AdminRes.FieldOptions (EL) <small class="text-light-muted">(@AdminRes.FieldOptionsHint)</small></label>
                                                        <textarea class="form-control form-control-sm" rows="4"
                                                                  @bind="q.OptionsTextEl"
                                                                  placeholder="Επιλογή 1&#10;Επιλογή 2&#10;Επιλογή 3"></textarea>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <button class="btn btn-sm btn-outline-success" @onclick="() => AddQuestion(section)">@AdminRes.AddQuestion</button>
                    </div>
                </div>
            }
        </ChildContent>
    </FormCardSection>
    </div>
    <SaveCancelBar SaveLabel="@AdminRes.SaveAssessment"
                    SavingLabel="@AdminRes.Saving"
                    IsSaving="isSaving"
                    OnSave="SaveAssessment"
                    CancelLabel="@AdminRes.Cancel"
                    OnCancel="GoBack" />
}

