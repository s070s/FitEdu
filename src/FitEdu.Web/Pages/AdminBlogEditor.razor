@page "/admin/blog/new"
@page "/admin/blog/{Id:guid}"
@attribute [Authorize(Roles = "Admin")]
@using FitEdu.Web.Shared
@using FitEdu.Web.Extensions

<AppPageTitle Text="@(_isEditMode ? AdminRes.EditArticle : AdminRes.NewArticle)" />

<div class="admin-editor">
    <header class="section-head">
        <h1>@(_isEditMode ? AdminRes.EditArticle : AdminRes.NewArticle)</h1>
    </header>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <UnsavedChangesGuard IsDirty="_isDirty" />

    <div @oninput="MarkDirty" @onchange="MarkDirty">
    <div class="row g-4">
        <!-- Left column: English content -->
        <section class="col-lg-6" aria-labelledby="blog-lang-en">
            <h2 id="blog-lang-en" class="blog-lang-title"><span class="chip chip--lime" aria-hidden="true">EN</span> @AdminRes.BlogLangEnglish</h2>

            <div class="mb-3">
                <label class="form-label" for="blog-title-en">@AdminRes.FieldTitle <span class="text-danger" aria-hidden="true">*</span></label>
                <input id="blog-title-en" type="text" class="form-control" value="@_titleEn"
                       @oninput="OnTitleEnInput" placeholder="@ContentLanguageText.English(nameof(AdminRes.BlogTitlePlaceholder))" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="blog-summary-en">@AdminRes.FieldSummary <span class="text-danger" aria-hidden="true">*</span></label>
                <textarea id="blog-summary-en" class="form-control" rows="3" maxlength="500"
                          @bind="_summaryEn" placeholder="@ContentLanguageText.English(nameof(AdminRes.BlogSummaryPlaceholder))"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">@AdminRes.FieldContent <span class="text-danger" aria-hidden="true">*</span></label>
                <QuillEditor @ref="_editorEn" Content="@_contentEn" MinHeight="400px" Placeholder="@ContentLanguageText.English(nameof(AdminRes.EditorPlaceholder))" />
            </div>
        </section>

        <!-- Right column: Greek content -->
        <section class="col-lg-6" aria-labelledby="blog-lang-el">
            <h2 id="blog-lang-el" class="blog-lang-title"><span class="chip chip--teal" aria-hidden="true">EL</span> @AdminRes.BlogLangGreek</h2>

            <div class="mb-3">
                <label class="form-label" for="blog-title-el">@AdminRes.FieldTitle</label>
                <input id="blog-title-el" type="text" class="form-control" lang="el" @bind="_titleEl" placeholder="@ContentLanguageText.Greek(nameof(AdminRes.BlogTitlePlaceholder))" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="blog-summary-el">@AdminRes.FieldSummary</label>
                <textarea id="blog-summary-el" class="form-control" rows="3" maxlength="500" lang="el"
                          @bind="_summaryEl" placeholder="@ContentLanguageText.Greek(nameof(AdminRes.BlogSummaryPlaceholder))"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">@AdminRes.FieldContent</label>
                <QuillEditor @ref="_editorEl" Content="@_contentEl" MinHeight="400px" Placeholder="@ContentLanguageText.Greek(nameof(AdminRes.EditorPlaceholder))" />
            </div>
        </section>
    </div>

    <!-- Shared fields -->
    <hr class="my-4" />
    <h2 class="blog-lang-title">@AdminRes.SharedFields</h2>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="blog-slug">@AdminRes.ColSlug <span class="text-danger" aria-hidden="true">*</span></label>
            <input id="blog-slug" type="text" class="form-control" value="@_slug"
                   @oninput="OnSlugInput" placeholder="@AdminRes.BlogSlugPlaceholder" />
            <div class="form-text">@AdminRes.SlugHint</div>
        </div>

        <div class="col-md-6">
            <label class="form-label" for="blog-author">@AdminRes.FieldAuthorName <span class="text-danger" aria-hidden="true">*</span></label>
            <input id="blog-author" type="text" class="form-control" @bind="_authorName" placeholder="@AdminRes.BlogAuthorPlaceholder" />
        </div>

        <div class="col-md-8">
            <label class="form-label" for="blog-cover-file">@AdminRes.FieldCoverImage</label>
            @if (!string.IsNullOrEmpty(_coverImageUrl))
            {
                <div class="cover-preview-row">
                    <img src="@_coverImageUrl" alt="@AdminRes.CoverPreviewAlt" class="cover-preview" width="320" height="180" />
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveCover">@AdminRes.Remove</button>
                </div>
            }
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <FilePicker @ref="_coverPicker" Id="blog-cover-file" OnChange="OnCoverFileSelected" Accept="image/*" />
                @if (!_isEditMode)
                {
                    <small class="form-text">@AdminRes.CoverUploadHint</small>
                }
            </div>
            <div class="mt-2">
                <input type="text" class="form-control form-control-sm" @bind="_coverImageUrl" placeholder="@AdminRes.CoverUrlPlaceholder" aria-label="@AdminRes.CoverUrlPlaceholder" />
            </div>
        </div>

        <div class="col-md-4">
            <label class="form-label" for="blog-tags">@AdminRes.FieldTags</label>
            <input id="blog-tags" type="text" class="form-control" @bind="_tagsInput"
                   placeholder="@AdminRes.BlogTagsPlaceholder" />
            <div class="form-text">@AdminRes.TagsHint</div>
        </div>

        <div class="col-12">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="isPublished" @bind="_isPublished" />
                <label class="form-check-label" for="isPublished">@AdminRes.StatusPublished</label>
            </div>
        </div>
    </div>
    </div>

    <div class="form-actions sticky-bottom-bar">
        <button class="btn-cta" @onclick="Save" disabled="@_isBusy">
            @if (_isBusy)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            }
            @AdminRes.Save
        </button>
        <button class="btn-cta btn-cta--ghost" @onclick="Cancel" disabled="@_isBusy">@AdminRes.Cancel</button>
    </div>
</div>
