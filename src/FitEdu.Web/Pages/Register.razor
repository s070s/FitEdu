@page "/register"
@implements IDisposable
@using FitEdu.Web.Extensions

<PageTitle>@GlobalRes.Label_Register</PageTitle>

<AuthCard Title="@GlobalRes.Label_CreateAccount" Subtitle="@GlobalRes.AuthRegisterSubtitle" Wide="true">
    <ChildContent>
        @* After a successful sign-up the form gives way to the result, which is scrolled into view
           for a phone user who tapped Register at the bottom of the long form. *@
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="register-success" role="status" tabindex="-1" @ref="successRegion">
                <div class="alert alert-success">
                    @if (Env.IsDevelopment())
                    {
                        @successMessage
                        <div class="mt-3">
                            <button class="btn btn-sm btn-warning" @onclick="DevConfirmEmail">@GlobalRes.Label_ConfirmEmail</button>
                        </div>
                    }
                    else
                    {
                        @SuccessMessagesRes.RegistrationSuccess
                    }
                </div>
                @RegisterErrors
                <a class="btn-cta auth-submit register-success__login" href="/login">@GlobalRes.Label_GoToLogin</a>
            </div>
        }
        else
        {
            <EditForm EditContext="editContext" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />

                <fieldset class="auth-group">
                    <legend class="auth-group__legend">@GlobalRes.Label_AboutYou</legend>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label for="firstName" class="form-label">@GlobalRes.Label_Info_FirstName</label>
                            <InputText id="firstName" class="form-control" autocomplete="given-name" @bind-Value="registerRequest.FirstName" />
                            <ValidationMessage For="@(() => registerRequest.FirstName)" />
                        </div>
                        <div class="col-sm-6">
                            <label for="lastName" class="form-label">@GlobalRes.Label_Info_LastName</label>
                            <InputText id="lastName" class="form-control" autocomplete="family-name" @bind-Value="registerRequest.LastName" />
                            <ValidationMessage For="@(() => registerRequest.LastName)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">@GlobalRes.Label_Info_Email</label>
                        <InputText id="email" inputmode="email" class="form-control" autocomplete="email" @bind-Value="registerRequest.Email" />
                        <ValidationMessage For="@(() => registerRequest.Email)" />
                    </div>

                    <div>
                        <label for="dob" class="form-label">@GlobalRes.Label_Info_DateOfBirth</label>
                        <InputDate id="dob" class="form-control" autocomplete="bday" @bind-Value="registerRequest.DateOfBirth" />
                    </div>
                </fieldset>

                <fieldset class="auth-group">
                    <legend class="auth-group__legend">@GlobalRes.Label_YourTraining</legend>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label for="status" class="form-label">@GlobalRes.Label_Info_Status</label>
                            <InputSelect id="status" class="form-select" @bind-Value="registerRequest.Status">
                                @foreach (var status in UserStatusLabels.Selectable)
                                {
                                    <option value="@status">@UserStatusLabels.Label(status)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-sm-6">
                            <label for="goal" class="form-label">@GlobalRes.Label_Info_Goal</label>
                            <InputSelect id="goal" class="form-select" aria-describedby="goal-help" @bind-Value="registerRequest.Goal">
                                <option value="">@GlobalRes.GoalNotSureYet</option>
                                @foreach (var goal in GoalOptions)
                                {
                                    <option value="@goal">@CourseLabels.Goal(goal)</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="form-text" id="goal-help">@GlobalRes.GoalHint</div>
                </fieldset>

                <div class="mb-3">
                    <label for="password" class="form-label">@GlobalRes.Label_Password</label>
                    <div class="input-group">
                        <InputText id="password" type="@passwordInputType" class="form-control" autocomplete="new-password" aria-describedby="password-help" @bind-Value="registerRequest.Password" />
                        <button type="button" class="btn btn-password-toggle" @onclick="TogglePasswordVisibility"
                                aria-label="@GlobalRes.ShowHidePassword"
                                aria-pressed="@(passwordInputType == "text" ? "true" : "false")">
                            <i class="@passwordIconClass" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="form-text" id="password-help">@GlobalRes.PasswordRulesHint</div>
                    <ValidationMessage For="@(() => registerRequest.Password)" />
                </div>

                <div class="mb-4">
                    <label for="confirmPassword" class="form-label">@GlobalRes.Label_ConfirmPassword</label>
                    <div class="input-group">
                        <InputText id="confirmPassword" type="@confirmPasswordInputType" class="form-control" autocomplete="new-password" @bind-Value="registerRequest.ConfirmPassword" />
                        <button type="button" class="btn btn-password-toggle" @onclick="ToggleConfirmPasswordVisibility"
                                aria-label="@GlobalRes.ShowHidePassword"
                                aria-pressed="@(confirmPasswordInputType == "text" ? "true" : "false")">
                            <i class="@confirmPasswordIconClass" aria-hidden="true"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => registerRequest.ConfirmPassword)" />
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox id="gdprConsent" class="form-check-input" @bind-Value="registerRequest.GdprConsent" />
                    <label for="gdprConsent" class="form-check-label">
                        @GlobalRes.Label_GdprConsent
                    </label>
                    <div class="form-text">
                        @GlobalRes.ConsentPolicyIntro
                        <a href="/privacy" target="_blank" rel="noopener">@LegalRes.PrivacyTitle</a>
                        @GlobalRes.ConsentPolicyAnd
                        <a href="/terms" target="_blank" rel="noopener">@LegalRes.TermsTitle</a>.
                    </div>
                    <ValidationMessage For="@(() => registerRequest.GdprConsent)" />
                </div>

                @* Server errors (such as an email already in use) show right above the button that was tapped. *@
                @RegisterErrors

                <button type="submit" class="btn-cta auth-submit" disabled="@isLoading">
                    @if (isLoading) { <span>@GlobalRes.Label_Registering</span> } else { <span>@GlobalRes.Label_Register</span> }
                </button>
            </EditForm>
        }
    </ChildContent>
    <Footer>
        @GlobalRes.Label_AlreadyHaveAccount <a href="/login">@GlobalRes.Label_Login</a>
    </Footer>
</AuthCard>

@code {
    // One live region for the server's messages: screen readers announce whatever appears in it.
    private RenderFragment RegisterErrors => @<div class="register-errors" role="alert" tabindex="-1" @ref="errorRegion">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (errors.Count > 0)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
    </div>;
}
