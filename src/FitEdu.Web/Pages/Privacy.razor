@page "/privacy"

<AppPageTitle Text="@LegalRes.PrivacyTitle" />

<LegalDocument Title="@LegalRes.PrivacyTitle"
               Intro="@LegalRes.PrivacyIntro"
               CanonicalPath="/privacy"
               Sections="Sections"
               OtherDocumentHref="/terms"
               OtherDocumentTitle="@LegalRes.TermsTitle" />

@code {
    private static IReadOnlyList<LegalDocument.Section> Sections =>
    [
        new(LegalRes.PrivacyDataTitle, LegalRes.PrivacyDataBody),
        new(LegalRes.PrivacyPurposeTitle, LegalRes.PrivacyPurposeBody),
        new(LegalRes.PrivacySpecialTitle, LegalRes.PrivacySpecialBody),
        new(LegalRes.PrivacyRetentionTitle, LegalRes.PrivacyRetentionBody),
        new(LegalRes.PrivacyRightsTitle, LegalRes.PrivacyRightsBody),
        new(LegalRes.PrivacyCookiesTitle, LegalRes.PrivacyCookiesBody),
        new(LegalRes.PrivacyContactTitle, LegalRes.PrivacyContactBody)
    ];
}
