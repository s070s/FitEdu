@page "/admin/paths/new"
@page "/admin/paths/{Id:guid}"
@attribute [Authorize(Roles = "Admin")]
@using FitEdu.Web.Extensions

<AppPageTitle Text="@(_isEditMode ? PathRes.EditPath : PathRes.NewPath)" />

<div class="admin-editor admin-editor--narrow">
    <header class="section-head">
        <h1>@(_isEditMode ? PathRes.EditPath : PathRes.NewPath)</h1>
    </header>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="p-titleen">@PathRes.FieldTitleEn <span class="text-danger" aria-hidden="true">*</span></label>
            <input id="p-titleen" type="text" class="form-control" @bind="_titleEn" maxlength="200" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="p-titleel">@PathRes.FieldTitleEl</label>
            <input id="p-titleel" type="text" class="form-control" @bind="_titleEl" maxlength="200" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="p-descen">@PathRes.FieldDescriptionEn</label>
            <textarea id="p-descen" class="form-control" rows="3" maxlength="2000" @bind="_descriptionEn"></textarea>
        </div>

        <div class="col-md-6">
            <label class="form-label" for="p-descel">@PathRes.FieldDescriptionEl</label>
            <textarea id="p-descel" class="form-control" rows="3" maxlength="2000" @bind="_descriptionEl"></textarea>
        </div>

        <div class="col-md-6">
            <label class="form-label" for="p-category">@PathRes.FieldCategory</label>
            <select id="p-category" class="form-select" value="@(_categoryId?.ToString() ?? "")" @onchange="OnCategoryChanged">
                <option value="">@PathRes.NoCategory</option>
                @foreach (var category in _categories)
                {
                    <option value="@category.Id">@AdminText.Pick(category.NameEn, category.NameEl)</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label" for="p-order">@PathRes.FieldDisplayOrder</label>
            <input id="p-order" type="number" class="form-control" @bind="_displayOrder" min="1" />
        </div>
    </div>

    <div class="form-actions">
        <button class="btn-cta" @onclick="Save" disabled="@_isBusy">
            @if (_isBusy)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            }
            @PathRes.Save
        </button>
        <button class="btn-cta btn-cta--ghost" @onclick="Cancel" disabled="@_isBusy">@PathRes.Cancel</button>
    </div>

    <hr class="my-4" />

    <h2>@PathRes.StepsSectionTitle</h2>

    @if (!_isEditMode)
    {
        <div class="alert alert-secondary py-2">
            <span class="bi bi-info-circle" aria-hidden="true"></span>
            @PathRes.AddStepsHint
        </div>
    }
    else
    {
        @if (_steps.Count == 0)
        {
            <p>@PathRes.NoStepsYet</p>
        }
        else
        {
            <ol class="step-list">
                @foreach (var step in _steps)
                {
                    <li class="step-row" @key="step.Id">
                        <div class="step-row__move">
                            <button class="btn btn-sm btn-outline-secondary" title="@PathRes.MoveUp" aria-label="@PathRes.MoveUp"
                                    disabled="@(step.StepOrder == 1)"
                                    @onclick="() => MoveStepUp(step.Id)"><span class="bi bi-arrow-up" aria-hidden="true"></span></button>
                            <button class="btn btn-sm btn-outline-secondary" title="@PathRes.MoveDown" aria-label="@PathRes.MoveDown"
                                    disabled="@(step.StepOrder == _steps.Count)"
                                    @onclick="() => MoveStepDown(step.Id)"><span class="bi bi-arrow-down" aria-hidden="true"></span></button>
                        </div>
                        <span class="step-order">@step.StepOrder.</span>
                        <span class="step-course-title">@AdminText.Pick(step.CourseTitle, step.CourseTitleEl)</span>
                        <button class="btn btn-sm btn-outline-danger step-row__remove" @onclick="() => RemoveStep(step.Id)">@PathRes.Remove</button>
                    </li>
                }
            </ol>
        }

        <div class="step-add">
            <select class="form-select" aria-label="@PathRes.SelectCourse" value="@(_selectedCourseIdToAdd?.ToString() ?? "")" @onchange="OnCourseToAddChanged">
                <option value="">@PathRes.SelectCourse</option>
                @foreach (var course in AvailableCoursesToAdd)
                {
                    <option value="@course.Id">@AdminText.Pick(course.TitleEn, course.TitleEl)</option>
                }
            </select>
            <button class="btn btn-primary" disabled="@(_selectedCourseIdToAdd is null)" @onclick="AddStep">@PathRes.AddStep</button>
        </div>
    }
</div>
