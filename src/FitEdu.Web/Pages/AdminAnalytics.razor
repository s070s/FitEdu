@page "/admin/analytics"
@attribute [Authorize(Roles = "Admin")]

<AppPageTitle Text="@AdminRes.PageTitle" />

<header class="section-head">
    <h1>@AdminRes.PageTitle</h1>
</header>

@if (_loading)
{
    <LoadingSpinner Label="@AdminRes.Loading" />
}
else if (_error is not null)
{
    <div class="alert alert-danger d-flex flex-wrap align-items-center gap-3" role="alert">
        <span>@_error</span>
        <button type="button" class="btn-cta btn-cta--ghost" @onclick="LoadAsync">@GlobalRes.TryAgain</button>
    </div>
}
else if (stats is not null)
{
    <div class="analytics-tiles">
        <StatTile Icon="bi-people" Value="@FormatCount(stats.TotalUsers)" Label="@AdminRes.TotalUsers" />
        <StatTile Icon="bi-person-check" Value="@FormatCount(stats.ActiveUsers)" Label="@AdminRes.ActiveUsers" />
        <StatTile Icon="bi-journal-plus" Value="@FormatCount(stats.TotalEnrollments)" Label="@AdminRes.TotalEnrollments" />
        <StatTile Icon="bi-trophy" Value="@FormatCount(stats.CompletedCourses)" Label="@AdminRes.CompletedCourses" />
    </div>

    <div class="analytics-panels">
        <section class="card-surface" aria-labelledby="course-stats-title">
            <div class="card-surface__body">
                <h2 id="course-stats-title" class="analytics-panel__title">@AdminRes.CourseEnrollmentStats</h2>
                @if (stats.CourseStats is { Count: > 0 })
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0" aria-labelledby="course-stats-title">
                            <thead>
                                <tr>
                                    <th scope="col">@AdminRes.ColCourse</th>
                                    <th scope="col">@AdminRes.ColEnrollments</th>
                                    <th scope="col">@AdminRes.ColCompletions</th>
                                    <th scope="col">@AdminRes.ColCompletionRate</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var courseStat in stats.CourseStats)
                                {
                                    var completionPercent = CompletionPercent(courseStat);
                                    <tr @key="courseStat.CourseTitle">
                                        <td data-label="@AdminRes.ColCourse">@courseStat.CourseTitle</td>
                                        <td data-label="@AdminRes.ColEnrollments">@FormatCount(courseStat.EnrollmentCount)</td>
                                        <td data-label="@AdminRes.ColCompletions">@FormatCount(courseStat.CompletionCount)</td>
                                        <td data-label="@AdminRes.ColCompletionRate">
                                            @if (completionPercent is null)
                                            {
                                                <text>—</text>
                                            }
                                            else
                                            {
                                                <span class="completion-rate">
                                                    <progress class="completion-rate__bar" max="100" value="@completionPercent" aria-hidden="true"></progress>
                                                    <span>@($"{completionPercent}%")</span>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-light-muted mb-0">@AdminRes.NoCourseData</p>
                }
            </div>
        </section>

        <section class="card-surface" aria-labelledby="assessment-stats-title">
            <div class="card-surface__body">
                <h2 id="assessment-stats-title" class="analytics-panel__title">@AdminRes.AssessmentStats</h2>
                @if (stats.AssessmentStats is { Count: > 0 })
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0" aria-labelledby="assessment-stats-title">
                            <thead>
                                <tr>
                                    <th scope="col">@AdminRes.ColAssessment</th>
                                    <th scope="col">@AdminRes.ColSubmissions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assessmentStat in stats.AssessmentStats)
                                {
                                    <tr @key="assessmentStat.AssessmentTitle">
                                        <td data-label="@AdminRes.ColAssessment">@assessmentStat.AssessmentTitle</td>
                                        <td data-label="@AdminRes.ColSubmissions">@FormatCount(assessmentStat.SubmissionCount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-light-muted mb-0">@AdminRes.NoAssessmentData</p>
                }
            </div>
        </section>
    </div>
}
