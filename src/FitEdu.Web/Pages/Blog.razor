@page "/blog"

@* UX-7: public blog index, linked from the nav and the home page. A magazine grid: the newest
   article is the wide featured card, the rest follow in the card grid. *@

<AppPageTitle Text="@HomeRes.BlogIndexTitle" />
<SeoHead Title="@HomeRes.BlogIndexTitle"
         Description="@HomeRes.BlogIndexSubtitle"
         CanonicalUrl="/blog" />

<div class="page blog-page">
    <header class="blog-head">
        <span class="eyebrow"><span class="bi @AppIcons.BlogArticle" aria-hidden="true"></span> @HomeRes.BlogIndexTitle</span>
        <h1>@HomeRes.BlogTitle <span class="text-volt">@HomeRes.BlogTitleHighlight</span></h1>
        <p class="blog-head__lead">@HomeRes.BlogIndexSubtitle</p>
    </header>

    @if (_loading)
    {
        <ul class="blog-grid blog-grid--magazine" aria-hidden="true">
            @for (var index = 0; index < SkeletonCardCount; index++)
            {
                <li class="blog-grid__item"><SkeletonBlock Height="22rem" CssClass="blog-skeleton" /></li>
            }
        </ul>
    }
    else if (_articles is { Count: > 0 })
    {
        <ul class="blog-grid blog-grid--magazine">
            @for (var index = 0; index < _articles.Count; index++)
            {
                var article = _articles[index];
                <li class="blog-grid__item @(index == 0 ? "blog-grid__item--featured" : "")" @key="article.Id">
                    <BlogCard Article="article" />
                </li>
            }
        </ul>
    }
    else
    {
        <EmptyState Icon="@AppIcons.BlogArticle" Title="@HomeRes.BlogIndexEmpty" />
    }
</div>
