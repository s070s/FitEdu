@page "/assessments"
@attribute [Authorize(Roles = "Student")]
@using FitEdu.Shared.Resources

<PageTitle>@AssessmentRes.AssessmentsPageTitle</PageTitle>

<div class="page assessments-page">
    <header class="section-head assessments-head">
        <div class="assessments-head__text">
            <span class="eyebrow">@AssessmentRes.AssessmentsEyebrow</span>
            <h1>@AssessmentRes.AvailableAssessments</h1>
            <p class="assessments-head__intro">@AssessmentRes.AssessmentsIntro</p>
        </div>
        <div class="section-head__actions assessments-head__actions">
            @if (_assessmentAccess && _catalogueTotal > 0)
            {
                var completedText = string.Format(AssessmentRes.CompletedCountFormat, CompletedCount, _catalogueTotal);
                <div class="assessments-progress">
                    <ProgressRing Value="@CompletedPercent" Size="48" Label="@CompletedRingText" AriaLabel="@completedText" />
                    <span class="assessments-progress__text">@completedText</span>
                </div>
            }
            <a href="/assessments/mine" class="btn-cta btn-cta--ghost assessments-head__history">
                <span class="bi bi-clock-history" aria-hidden="true"></span> @AssessmentRes.ViewSubmissions
            </a>
        </div>
    </header>

    @if (_loading)
    {
        <LoadingSpinner Label="@AssessmentRes.LoadingAssessments" />
    }
    else if (!_assessmentAccess)
    {
        <UpgradePrompt PlanName="Plus"
                       FeatureName="Assessments"
                       Description="@AssessmentRes.UpgradeDescription" />
    }
    else if (_error is not null)
    {
        <p class="text-danger" role="alert">@_error</p>
    }
    else if (_pagedResult is null || (_pagedResult.TotalCount == 0 && !HasActiveFilter))
    {
        <EmptyState Icon="bi-clipboard2-pulse" Title="@AssessmentRes.NoAssessmentsAvailable" />
    }
    else
    {
        <CategoryFilterBar Categories="_categories"
                            SelectedCategoryId="_selectedCategoryId"
                            OnCategorySelected="OnCategorySelected"
                            SearchText="@_search"
                            OnSearchChanged="OnSearchChanged"
                            SearchPlaceholder="@CategoryRes.SearchPlaceholder" />

        @if (_pagedResult.TotalCount == 0)
        {
            <EmptyState Icon="bi-search" Title="@CategoryRes.NoMatchingResults" />
        }
        else
        {
            <div class="pagination-toolbar">
                <span class="pagination-info">
                    @string.Format(AssessmentRes.TotalAssessmentsFormat, _pagedResult.TotalCount)
                </span>
                <div class="page-size-selector">
                    <label for="assessmentPageSizeSelect">@AssessmentRes.PerPage</label>
                    <select id="assessmentPageSizeSelect" class="form-select form-select-sm"
                            value="@_pageSize"
                            @onchange="e => ChangePageSize(int.Parse(e.Value!.ToString()!))">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size" selected="@(_pageSize == size)">@size</option>
                        }
                    </select>
                </div>
            </div>

            <div class="grid-auto assessments-grid">
                @foreach (var assessment in _pagedResult.Items)
                {
                    <AssessmentCard @key="assessment.Id" Assessment="assessment" IsCompleted="@_completedIds.Contains(assessment.Id)" />
                }
            </div>

            <PaginationNav CurrentPage="_page"
                            TotalPages="_pagedResult.TotalPages"
                            HasPreviousPage="_pagedResult.HasPreviousPage"
                            HasNextPage="_pagedResult.HasNextPage"
                            PreviousLabel="@AssessmentRes.Previous"
                            NextLabel="@AssessmentRes.Next"
                            AriaLabel="@AssessmentRes.PaginationAriaLabel"
                            OnPageChanged="GoToPage" />
        }
    }
</div>
