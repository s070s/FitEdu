@page "/search"

<AppPageTitle Text="@SearchRes.PageTitle" />

<div class="page search-page">
    <header class="search-head">
        <h1>@(string.IsNullOrWhiteSpace(Q) ? SearchRes.PageTitle : string.Format(SearchRes.ResultsForFormat, Q))</h1>

        @* A plain GET form, so searching also works before the page turns interactive; once it is,
           the submit handler navigates in place. *@
        <form class="search-form" role="search" action="/search" method="get" @onsubmit="Submit" @onsubmit:preventDefault>
            <span class="bi bi-search search-form__icon" aria-hidden="true"></span>
            <input type="search" name="q" class="form-control search-form__input" placeholder="@SearchRes.Placeholder"
                   aria-label="@SearchRes.SearchLabel" enterkeyhint="search"
                   value="@_input" @oninput="e => _input = e.Value?.ToString() ?? string.Empty" />
            <button type="submit" class="btn-cta search-form__submit">@SearchRes.SearchLabel</button>
        </form>
    </header>

    @if (string.IsNullOrWhiteSpace(Q))
    {
        <EmptyState Icon="bi-search" Title="@SearchRes.EnterQuery" />
    }
    else if (_loading)
    {
        <LoadingSpinner Label="@SearchRes.SearchLabel" />
    }
    else if (_result is { Hits.Count: 0 })
    {
        <EmptyState Icon="bi-search" Title="@SearchRes.NoResults" />
    }
    else if (_result is not null)
    {
        @if (!_result.SemanticSearchUsed)
        {
            <p class="search-notice"><span class="bi bi-info-circle" aria-hidden="true"></span> @SearchRes.FallbackNotice</p>
        }
        <ul class="search-results">
            @foreach (var hit in _result.Hits)
            {
                <li>
                    <a class="site-search-result-card" href="@hit.Url">
                        <span class="site-search-result-icon" aria-hidden="true"><span class="bi @AppIcons.ForSearchSource(hit.SourceType)"></span></span>
                        <span class="site-search-result-body">
                            <span class="site-search-result-type">@TypeLabel(hit.SourceType)</span>
                            <span class="site-search-result-title">@hit.Title</span>
                            @if (!string.IsNullOrEmpty(hit.Snippet))
                            {
                                <span class="site-search-result-snippet">@hit.Snippet</span>
                            }
                        </span>
                        <span class="bi bi-chevron-right site-search-result-arrow" aria-hidden="true"></span>
                    </a>
                </li>
            }
        </ul>
    }
</div>
