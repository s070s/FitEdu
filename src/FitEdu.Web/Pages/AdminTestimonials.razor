@page "/admin/testimonials"
@attribute [Authorize(Roles = "Admin")]
@using FitEdu.Web.Shared.Components.Data

<AppPageTitle Text="@AdminRes.TestimonialsPageTitle" />

<div class="admin-container">
    <h1 class="h2">@AdminRes.TestimonialsPageTitle</h1>

    <DismissibleAlert Message="@message" AlertType="@messageType" OnDismiss="@(() => message = string.Empty)" />

    <div class="admin-toolbar">
        <button class="btn-cta text-nowrap" @onclick="NewTestimonial">@AdminRes.NewTestimonial</button>
    </div>

    <AuthorizeView Roles="Admin">
        <Authorized>
            @if (pagedResult == null)
            {
                <LoadingSpinner Label="@AdminRes.Loading" />
            }
            else if (!pagedResult.Items.Any())
            {
                <p>@AdminRes.NoTestimonialsFound</p>
            }
            else
            {
                <ScrollableTable Items="pagedResult.Items" TItem="AdminTestimonialDto" Caption="@AdminRes.TestimonialsPageTitle">
                    <HeaderRow>
                        <tr>
                            <SortableColumnHeader ColumnKey="displayorder" Label="@AdminRes.ColOrder"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <SortableColumnHeader ColumnKey="name" Label="@AdminRes.ColName"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <th>@AdminRes.ColRoleCompany</th>
                            <SortableColumnHeader ColumnKey="status" Label="@AdminRes.ColStatus"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <SortableColumnHeader ColumnKey="createdat" Label="@AdminRes.ColCreated"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <th>@AdminRes.ColActions</th>
                        </tr>
                    </HeaderRow>
                    <RowTemplate Context="item">
                        <tr @key="item.Id">
                            <td data-label="@AdminRes.ColOrder">
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            title="@(IsDefaultSort ? AdminRes.MoveUp : AdminRes.ResetSortToReorder)"
                                            disabled="@(!IsDefaultSort)"
                                            aria-label="@AdminRes.MoveUp"
                                            @onclick="() => MoveUp(item.Id)"><span class="bi bi-arrow-up" aria-hidden="true"></span></button>
                                    <span class="px-1 align-self-center">@item.DisplayOrder</span>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            title="@(IsDefaultSort ? AdminRes.MoveDown : AdminRes.ResetSortToReorder)"
                                            disabled="@(!IsDefaultSort)"
                                            aria-label="@AdminRes.MoveDown"
                                            @onclick="() => MoveDown(item.Id)"><span class="bi bi-arrow-down" aria-hidden="true"></span></button>
                                </div>
                            </td>
                            <td data-label="@AdminRes.ColName">@item.FullName</td>
                            <td data-label="@AdminRes.ColRoleCompany">
                                @if (!string.IsNullOrEmpty(item.RoleOrTitle) || !string.IsNullOrEmpty(item.CompanyOrContext))
                                {
                                    <span>@item.RoleOrTitle</span>
                                    @if (!string.IsNullOrEmpty(item.RoleOrTitle) && !string.IsNullOrEmpty(item.CompanyOrContext))
                                    {
                                        <span class="text-light-muted"> · </span>
                                    }
                                    <span class="text-light-muted">@item.CompanyOrContext</span>
                                }
                                else
                                {
                                    <span class="text-light-muted">—</span>
                                }
                            </td>
                            <td data-label="@AdminRes.ColStatus">
                                <StatusBadge IsActive="item.IsActive"
                                             ActiveText="@AdminRes.StatusActive"
                                             InactiveText="@AdminRes.StatusInactive" />
                            </td>
                            <td data-label="@AdminRes.ColCreated">@SiteClock.ToSiteTime(item.CreatedAt).ToString("d")</td>
                            <td class="table-actions" data-label="@AdminRes.ColActions">
                                <button class="btn btn-sm btn-primary me-1" @onclick="() => EditTestimonial(item.Id)">@AdminRes.Edit</button>
                                @if (item.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ToggleActive(item.Id)">@AdminRes.Deactivate</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ToggleActive(item.Id)">@AdminRes.Activate</button>
                                }
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDeleteTestimonial(item.Id)">@AdminRes.Delete</button>
                            </td>
                        </tr>
                    </RowTemplate>
                </ScrollableTable>

                <AdminPaginationToolbar CurrentPage="pagedResult.Page"
                                        TotalPages="pagedResult.TotalPages"
                                        TotalCount="pagedResult.TotalCount"
                                        PageSize="pagedResult.PageSize"
                                        HasPreviousPage="pagedResult.HasPreviousPage"
                                        HasNextPage="pagedResult.HasNextPage"
                                        PageSizeOptions="PageSizeOptions"
                                        ItemLabel="@AdminRes.ItemLabelTestimonials"
                                        OnPageSizeChanged="OnPageSizeChanged"
                                        OnPreviousPage="PreviousPage"
                                        OnNextPage="NextPage" />
            }
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-danger">@AdminRes.AccessDenied</div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<ConfirmModal IsVisible="@(confirmDeleteId is not null)"
              Title="@AdminRes.ConfirmTitle"
              Message="@AdminRes.ConfirmDeleteTestimonial"
              ConfirmLabel="@AdminRes.Delete"
              CancelLabel="@AdminRes.Cancel"
              OnConfirm="DeleteTestimonial"
              OnCancel="CancelDeleteTestimonial" />
