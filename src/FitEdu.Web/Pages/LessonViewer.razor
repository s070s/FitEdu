@page "/lessons/{LessonId:guid}"
@attribute [Authorize]

<AppPageTitle Text="@(_lesson?.Title ?? LessonRes.LessonDefault)" />

@if (_loading)
{
    <LoadingSpinner Label="@LessonRes.LoadingLesson" />
}
else if (_error is not null || _lesson is null)
{
    @* Without the lesson the course is unknown, so the way out is the programme list. *@
    <div class="page lesson-container">
        <h1 class="visually-hidden">@LessonRes.LessonUnavailableTitle</h1>
        <EmptyState Icon="@(_loadFailed ? "bi-wifi-off" : "bi-search")"
                    Title="@LessonRes.LessonUnavailableTitle"
                    Text="@(_error ?? LessonRes.LessonNotFound)"
                    ActionHref="/courses"
                    ActionLabel="@CourseRes.BackToCourses" />
    </div>
}
else
{
    var exerciseCountText = Exercises.Count == 1
        ? LessonRes.ExerciseCountOne
        : string.Format(LessonRes.ExerciseCountFormat, Exercises.Count);
    <div class="page lesson-container">
        <nav class="lesson-nav-top" aria-label="@LessonRes.BreadcrumbLabel">
            <a class="lesson-nav-top__course" href="@CourseHref(_lesson.CourseId)">
                <span class="bi bi-arrow-left" aria-hidden="true"></span>
                <span>@_lesson.CourseTitle</span>
            </a>
            <span class="breadcrumb-separator bi bi-chevron-right" aria-hidden="true"></span>
            <span class="module-name">@_lesson.ModuleTitle</span>
        </nav>

        <header class="lesson-header">
            @if (LessonNumber > 0)
            {
                <p class="eyebrow lesson-header__position">@string.Format(LessonRes.LessonOfFormat, LessonNumber, _courseLessons.Count)</p>
            }
            <h1>@_lesson.Title</h1>

            <ul class="chip-row lesson-meta">
                @if (_lesson.DurationMinutes.HasValue)
                {
                    <li class="chip duration"><span class="bi bi-stopwatch" aria-hidden="true"></span> @_lesson.DurationMinutes @LessonRes.Minutes</li>
                }
                @if (Exercises.Count > 0)
                {
                    <li>
                        <a class="chip chip--teal lesson-meta__workout-link" href="@WorkoutHref">
                            <span class="bi bi-list-ol" aria-hidden="true"></span> @exerciseCountText
                            <span class="bi bi-arrow-down-short" aria-hidden="true"></span>
                        </a>
                    </li>
                }
                @if (_lesson.IsCompleted)
                {
                    <li class="chip chip--lime"><span class="bi bi-check2-circle" aria-hidden="true"></span> @LessonRes.CompletedIndicator</li>
                }
            </ul>

            @if (_progress is not null)
            {
                <div class="lesson-progress">
                    <div class="lesson-progress__labels">
                        <span>@string.Format(LessonRes.CourseProgressFormat, _progress.CompletedLessons, _progress.TotalLessons)</span>
                        <span class="lesson-progress__percent">@_progress.Percent%</span>
                    </div>
                    <div class="lesson-progress__track" role="progressbar" aria-label="@LessonRes.CourseProgressLabel"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="@_progress.Percent">
                        <div class="lesson-progress__fill" style="width: @(_progress.Percent)%"></div>
                    </div>
                </div>
            }
        </header>

        <div class="lesson-content">
            @if (IsVideo(_lesson))
            {
                @* Video lesson *@
                <div class="video-container">
                    @if (_mediaError)
                    {
                        <p class="text-danger media-unavailable" role="alert">@LessonRes.MediaUnavailable</p>
                    }
                    else if (IsYouTubeUrl(_lesson.Content))
                    {
                        <iframe
                            src="@ToEmbedUrl(_lesson.Content)"
                            title="@_lesson.Title"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen>
                        </iframe>
                    }
                    else
                    {
                        <video controls controlsList="nodownload" preload="metadata" @onerror="OnMediaError">
                            <source src="@VideoAssetUrl" />
                        </video>
                    }
                </div>
            }
            else if (IsPdf(_lesson))
            {
                @* PDF lesson *@
                <div class="pdf-container">
                    <iframe src="@PdfAssetUrl" title="@_lesson.Title"></iframe>
                </div>
            }
            else
            {
                @* Text lesson - render HTML from WYSIWYG or markdown from seed data *@
                <div class="text-content">
                    @((MarkupString)ContentHtml)
                </div>
            }
        </div>

        @if (Exercises.Count > 0)
        {
            <section class="lesson-workout" id="@WorkoutSectionId" aria-labelledby="lesson-workout-title">
                <div class="section-head lesson-workout__head">
                    <h2 id="lesson-workout-title">@LessonRes.Exercises</h2>
                    <ul class="chip-row lesson-workout__summary">
                        <li class="chip">@exerciseCountText</li>
                        @* A single set is not worth a total. *@
                        @if (TotalSets > 1)
                        {
                            <li class="chip">@ResourceFormat.Count(TotalSets, LessonRes.TotalSetsOne, LessonRes.TotalSetsFormat)</li>
                        }
                    </ul>
                </div>

                <ol class="lesson-workout__list">
                    @for (var index = 0; index < Exercises.Count; index++)
                    {
                        var exerciseNumber = index + 1;
                        var exercise = Exercises[index];
                        <li @key="exercise.Id">
                            <ExerciseCard Prescription="exercise" Position="exerciseNumber" />
                        </li>
                    }
                </ol>
            </section>
        }

        <div class="lesson-actions @(IsActionBarDocked ? "sticky-bottom-bar lesson-actions--docked" : "")">
            @if (!_lesson.IsCompleted)
            {
                <p class="lesson-actions__hint">@LessonRes.CompleteHint</p>
                <button type="button" class="btn btn-success" @onclick="MarkComplete" disabled="@_completing">
                    <span class="bi @(_completing ? "bi-hourglass-split" : "bi-check2")" aria-hidden="true"></span>
                    @(_completing ? LessonRes.Saving : LessonRes.MarkAsComplete)
                </button>
            }
            else if (_completionResult is { CourseCompleted: true })
            {
                @* The dock is what a phone shows when the last workout is done, so the celebration and
                   the certificate (or the upgrade to get one) sit in it, not 7000 px down the page. *@
                <section class="course-celebration" role="status" aria-labelledby="course-celebration-title">
                    <span class="course-celebration__icon" aria-hidden="true"><span class="bi bi-trophy-fill"></span></span>
                    <div class="course-celebration__text">
                        <h2 id="course-celebration-title" class="course-celebration__title">@LessonRes.CourseCompleted</h2>
                        <p class="course-celebration__note">@CertificateNote</p>
                    </div>
                    <div class="course-celebration__actions">
                        <a class="btn btn-success course-celebration__certificate" href="@CertificateHref">@CertificateLinkText</a>
                        <a class="btn btn-secondary course-celebration__course" href="@CourseHref(_lesson.CourseId)">@LessonRes.BackToCourse</a>
                    </div>
                </section>
            }
            else
            {
                var showDockedNext = _completionResult is not null && _lesson.NextLessonId is not null;
                <span class="completed-indicator">
                    <span class="bi bi-check-circle-fill" aria-hidden="true"></span>
                    <span class="completed-indicator__label">@LessonRes.CompletedIndicator</span>
                    @if (showDockedNext)
                    {
                        @* The phone dock swaps in this short word beside the next button (CSS). *@
                        <span class="completed-indicator__short" aria-hidden="true">@LessonRes.CompletedShort</span>
                    }
                </span>
                @* Right after a completion the phone dock offers the next lesson; the full links follow below. *@
                @if (showDockedNext && _lesson.NextLessonId is { } dockedNextLessonId)
                {
                    <a class="btn btn-success lesson-actions__next" href="@LessonHref(dockedNextLessonId)">
                        @LessonRes.NextLesson <span class="bi bi-arrow-right" aria-hidden="true"></span>
                    </a>
                }
            }

            @if (_completionError is not null)
            {
                <p class="text-danger lesson-actions__error" role="alert">@_completionError</p>
            }
        </div>

        @* In the flow, not in the dock: the progress line would make the docked bar taller on a
           phone. A finished programme celebrates in the dock instead (above). *@
        @if (_completionResult is not null)
        {
            <div class="progress-update" role="status">
                @string.Format(LessonRes.ProgressFormat, _completionResult.CompletedLessons, _completionResult.TotalLessons, _progress?.Percent ?? 0)
            </div>
        }

        <nav class="lesson-navigation @(_lesson.IsCompleted ? "lesson-navigation--ready" : "")" aria-label="@LessonRes.LessonNavigationLabel">
            @if (_lesson.PreviousLessonId is { } previousLessonId)
            {
                <a class="btn btn-secondary lesson-navigation__link" href="@LessonHref(previousLessonId)">
                    <span class="lesson-navigation__label"><span class="bi bi-arrow-left" aria-hidden="true"></span> @LessonRes.PreviousLesson</span>
                    @if (LessonTitle(previousLessonId) is { } previousTitle)
                    {
                        <span class="lesson-navigation__title">@previousTitle</span>
                    }
                </a>
            }
            else
            {
                <span></span>
            }

            @if (_lesson.NextLessonId is { } nextLessonId)
            {
                <a class="btn btn-primary lesson-navigation__link lesson-navigation__link--forward" href="@LessonHref(nextLessonId)">
                    <span class="lesson-navigation__label">@LessonRes.NextLesson <span class="bi bi-arrow-right" aria-hidden="true"></span></span>
                    @if (LessonTitle(nextLessonId) is { } nextTitle)
                    {
                        <span class="lesson-navigation__title">@nextTitle</span>
                    }
                </a>
            }
            else
            {
                <a class="btn btn-secondary lesson-navigation__link lesson-navigation__link--forward" href="@CourseHref(_lesson.CourseId)">
                    <span class="lesson-navigation__label">@LessonRes.BackToCourse <span class="bi bi-grid" aria-hidden="true"></span></span>
                    <span class="lesson-navigation__title">@_lesson.CourseTitle</span>
                </a>
            }
        </nav>
    </div>
}
