@page "/courses"

<AppPageTitle Text="@CourseRes.CoursesPageTitle" />

<div class="page courses-page">
    <header class="courses-head">
        <span class="eyebrow">@CourseRes.CatalogueEyebrow</span>
        <h1 class="courses-head__title">@CourseRes.AvailableCourses</h1>
        <p class="courses-head__intro">@CourseRes.CatalogueIntro</p>
    </header>

    @if (IsCatalogueEmpty)
    {
        <EmptyState Icon="bi-activity" Title="@CourseRes.NoCoursesAvailable" />
    }
    else
    {
        @if (ShowPlanBanner)
        {
            <div class="plan-limit-banner @(IsPlanFull ? "plan-limit-full" : "")">
                <span class="plan-limit-banner__icon bi @(IsPlanFull ? "bi-exclamation-circle" : "bi-stars")" aria-hidden="true"></span>
                <p class="plan-limit-banner__text">
                    <span>@string.Format(CourseRes.PlanCourseLimitFormat, TierLabels.Name(_userStatus!.Tier), _maxCourses)</span>
                    @if (IsPlanFull)
                    {
                        <span class="slots-full-label">@CourseRes.CourseSlotsFullNotice</span>
                    }
                </p>
                @* Lime only when the plan is full: then upgrading is the one way forward. *@
                <a class="btn-cta plan-limit-banner__action @(IsPlanFull ? "" : "btn-cta--ghost")" href="/pricing">
                    @CourseRes.UpgradePlan
                    <span class="bi bi-arrow-right" aria-hidden="true"></span>
                </a>
            </div>
        }

        <CategoryFilterBar Categories="_categories"
                           SelectedCategoryId="_selectedCategoryId"
                           OnCategorySelected="OnCategorySelected"
                           SearchText="@_search"
                           OnSearchChanged="OnSearchChanged"
                           SearchPlaceholder="@CourseRes.SearchCoursesPlaceholder"
                           ExtraFilterCount="ExtraFilterCount">
            <ExtraFilters>
                <FilterChipGroup Label="@CourseRes.Goal"
                                 AllLabel="@CourseRes.AllGoals"
                                 Options="_goalOptions"
                                 SelectedValue="@_goal?.ToString()"
                                 OnSelected="OnGoalSelected" />
                <FilterChipGroup Label="@CourseRes.Level"
                                 AllLabel="@CourseRes.AllLevels"
                                 Options="_levelOptions"
                                 SelectedValue="@_level?.ToString()"
                                 OnSelected="OnLevelSelected" />
                <FilterChipGroup Label="@CourseRes.Equipment"
                                 AllLabel="@CourseRes.AllEquipment"
                                 Options="_equipmentOptions"
                                 SelectedValue="@_equipment"
                                 OnSelected="OnEquipmentSelected" />
            </ExtraFilters>
        </CategoryFilterBar>

        <div class="courses-results" aria-busy="@(ShowSkeleton ? "true" : "false")">
            @if (ShowSkeleton)
            {
                <p class="visually-hidden" role="status">@CourseRes.LoadingCourses</p>
                <div class="courses-grid grid-auto skeleton-grid" aria-hidden="true">
                    @for (var index = 0; index < SkeletonCardCount; index++)
                    {
                        <div class="card-surface course-skeleton">
                            <SkeletonBlock CssClass="course-skeleton__cover" Height="auto" />
                            <div class="card-surface__body course-skeleton__body">
                                <SkeletonBlock CssClass="course-skeleton__chip" Width="6.5rem" Height="1.75rem" />
                                <SkeletonBlock Width="80%" Height="1.25rem" />
                                <SkeletonBlock Rows="2" Height="0.85rem" />
                                <SkeletonBlock Width="55%" Height="0.85rem" />
                            </div>
                        </div>
                    }
                </div>
            }
            else if (_error is not null)
            {
                <EmptyState Icon="bi-wifi-off" Title="@_error">
                    <button type="button" class="btn-cta btn-cta--ghost" @onclick="LoadCoursesAsync">@GlobalRes.TryAgain</button>
                </EmptyState>
            }
            else if (_pagedResult is null || _pagedResult.TotalCount == 0)
            {
                <EmptyState Icon="bi-funnel" Title="@CategoryRes.NoMatchingResults" Text="@CourseRes.NoMatchingCoursesHint">
                    <button type="button" class="btn-cta btn-cta--ghost courses-clear-filters" @onclick="ClearFiltersAsync">
                        <span class="bi bi-x-lg" aria-hidden="true"></span>
                        @CategoryRes.ClearFilters
                    </button>
                </EmptyState>
            }
            else
            {
                <div class="pagination-toolbar courses-toolbar">
                    <div class="courses-toolbar__summary">
                        <p class="courses-toolbar__count" role="status">
                            @string.Format(CourseRes.TotalCoursesFormat, _pagedResult.TotalCount)
                        </p>
                        @if (HasActiveFilter)
                        {
                            <button type="button" class="courses-toolbar__clear courses-clear-filters" @onclick="ClearFiltersAsync">
                                <span class="bi bi-x-lg" aria-hidden="true"></span>
                                @CategoryRes.ClearFilters
                            </button>
                        }
                    </div>
                    <div class="page-size-selector">
                        <label for="pageSizeSelect">@CourseRes.PerPage</label>
                        <select id="pageSizeSelect" class="form-select form-select-sm" @onchange="OnPageSizeChanged">
                            @foreach (var size in PageSizeOptions)
                            {
                                <option value="@size" selected="@(_pageSize == size)">@size</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="courses-grid grid-auto stagger">
                    @foreach (var course in _pagedResult.Items)
                    {
                        <CourseCard Course="course" IsLocked="IsLocked(course)" @key="course.Id" />
                    }
                </div>

                <div class="courses-pagination">
                    <PaginationNav CurrentPage="_page"
                                   TotalPages="_pagedResult.TotalPages"
                                   HasPreviousPage="_pagedResult.HasPreviousPage"
                                   HasNextPage="_pagedResult.HasNextPage"
                                   PreviousLabel="@CourseRes.Previous"
                                   NextLabel="@CourseRes.Next"
                                   OnPageChanged="GoToPage" />
                </div>
            }
        </div>
    }
</div>
