@page "/blog/{Slug}"
@using System.Globalization
@using FitEdu.Web.Extensions

@if (_loading)
{
    <div class="page blog-article-page" aria-hidden="true">
        <div class="blog-article-skeleton">
            <SkeletonBlock Height="1rem" Width="8rem" />
            <SkeletonBlock Height="2.75rem" Width="min(100%, 36rem)" />
            <SkeletonBlock Height="1rem" Width="14rem" />
            <SkeletonBlock Height="clamp(12rem, 45vw, 28rem)" CssClass="blog-article-skeleton__cover" />
            <SkeletonBlock Rows="6" Height="1rem" Gap="0.75rem" />
        </div>
    </div>
}
else if (_notFound || _article is null)
{
    <div class="page blog-article-page">
        <h1 class="visually-hidden">@HomeRes.BlogNotFoundTitle</h1>
        <EmptyState Icon="@AppIcons.BlogArticle"
                    Title="@HomeRes.BlogNotFoundTitle"
                    Text="@HomeRes.BlogNotFoundBody"
                    ActionHref="/blog"
                    ActionLabel="@HomeRes.BlogBackToArticles" />
    </div>
}
else
{
    <PageTitle>@_article.Title</PageTitle>
    <SeoHead Title="@_article.Title"
             Description="@_article.Summary"
             CanonicalUrl="@($"/blog/{_article.Slug}")"
             ImageUrl="@CoverUrl"
             OgType="article" />

    <div class="page blog-article-page">
        <article class="blog-article">
            <nav class="blog-article-back" aria-label="@HomeRes.BlogIndexTitle">
                <a href="/blog"><span class="bi bi-arrow-left" aria-hidden="true"></span> @HomeRes.BlogBackToArticles</a>
            </nav>

            <header class="blog-article-header">
                @if (_article.Tags.Length > 0)
                {
                    <ul class="chip-row blog-article-tags">
                        @foreach (var tag in _article.Tags)
                        {
                            <li class="chip chip--lime">@BlogTagLabels.Label(tag)</li>
                        }
                    </ul>
                }

                <h1 class="blog-article-title">@_article.Title</h1>

                @if (!string.IsNullOrWhiteSpace(_article.Summary))
                {
                    <p class="blog-article-lead">@_article.Summary</p>
                }

                <div class="blog-article-meta">
                    <span class="blog-article-author">
                        <span class="blog-article-author__mark" aria-hidden="true">@AuthorInitial</span>
                        @_article.AuthorName
                    </span>
                    @if (_article.PublishedAt is { } publishedAt)
                    {
                        var localDate = publishedAt.ToLocalTime();
                        <time datetime="@localDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@localDate.ToString("d MMMM yyyy", CultureInfo.CurrentCulture)</time>
                    }
                    <span><span class="bi bi-clock" aria-hidden="true"></span> @string.Format(HomeRes.BlogReadingTimeFormat, _readingMinutes)</span>
                </div>
            </header>

            @if (CoverUrl is not null)
            {
                <figure class="blog-article-cover">
                    <img src="@CoverUrl" alt="" width="@CoverWidth" height="@CoverHeight" decoding="async" fetchpriority="high" />
                </figure>
            }

            <div class="blog-article-content">
                @((MarkupString)_article.Content)
            </div>

            <footer class="blog-article-footer">
                <a href="/blog" class="btn-cta btn-cta--ghost"><span class="bi bi-grid" aria-hidden="true"></span> @HomeRes.BlogBackToArticles</a>
            </footer>
        </article>
    </div>
}
