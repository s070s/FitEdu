@page "/login"

<PageTitle>@GlobalRes.Label_Login</PageTitle>

<AuthCard Title="@GlobalRes.Label_Login" Subtitle="@GlobalRes.AuthLoginSubtitle">
    <ChildContent>
        @if (!string.IsNullOrEmpty(devSuccessMessage))
        {
            <div class="alert alert-success">@devSuccessMessage</div>
        }

        @if (unconfirmedEmailPending)
        {
            <div class="alert alert-warning">
                @ErrorMessagesRes.EmailNotConfirmedHint
                @if (Env.IsDevelopment())
                {
                    <div class="mt-2">
                        <button class="btn btn-sm btn-warning" @onclick="DevConfirmPendingEmail">@GlobalRes.Label_ConfirmEmail</button>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage) && !unconfirmedEmailPending)
        {
            <div class="alert alert-danger">
                @errorMessage
                <div class="mt-1"><a href="/forgot-password">@GlobalRes.Label_ForgotPassword</a></div>
            </div>
        }

        <EditForm Model="loginRequest" OnValidSubmit="HandleLogin" autocomplete="off">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="email" class="form-label">@GlobalRes.Label_Info_Email</label>
                <InputText id="email" inputmode="email" class="form-control" autocomplete="username" @bind-Value="loginRequest.Email" />
                <ValidationMessage For="@(() => loginRequest.Email)" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">@GlobalRes.Label_Password</label>
                <div class="input-group">
                    <InputText id="password" type="@passwordInputType" class="form-control" autocomplete="current-password" @bind-Value="loginRequest.Password" />
                    <button type="button" class="btn btn-password-toggle" @onclick="TogglePasswordVisibility"
                            aria-label="@GlobalRes.ShowHidePassword"
                            aria-pressed="@(passwordInputType == "text" ? "true" : "false")">
                        <i class="@passwordIconClass" aria-hidden="true"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => loginRequest.Password)" />
            </div>

            <div class="auth-row">
                <div class="form-check">
                    <InputCheckbox id="rememberMe" class="form-check-input" @bind-Value="loginRequest.RememberMe" />
                    <label class="form-check-label" for="rememberMe">@GlobalRes.Label_RememberMe</label>
                </div>
                <a href="/forgot-password">@GlobalRes.Label_ForgotPassword</a>
            </div>

            <button type="submit" class="btn-cta auth-submit" disabled="@isLoading">
                @if (isLoading) { <span>@GlobalRes.Label_LoggingIn</span> } else { <span>@GlobalRes.Label_Login</span> }
            </button>
        </EditForm>
    </ChildContent>
    <Footer>
        @GlobalRes.Label_NoAccount <a href="/register">@GlobalRes.Label_Register</a>
    </Footer>
</AuthCard>
