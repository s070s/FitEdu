@page "/paths"

<AppPageTitle Text="@PathRes.PathsTitle" />
<SeoHead Title="@PathRes.PathsTitle" Description="@PathRes.PathsSubtitle" CanonicalUrl="/paths" />

<section class="page paths-page">
    <header class="paths-hero">
        <span class="eyebrow">
            <span class="bi bi-signpost-split" aria-hidden="true"></span>
            @PathRes.PathsEyebrow
        </span>
        <h1 class="paths-hero__title">@PathRes.PathsTitle</h1>
        <p class="paths-hero__lead">@PathRes.PathsSubtitle</p>
    </header>

    @if (_loading)
    {
        <div class="grid-auto" aria-busy="true">
            @for (var index = 0; index < SkeletonCardCount; index++)
            {
                <SkeletonBlock Height="12rem" CssClass="paths-skeleton" />
            }
        </div>
    }
    else if (_paths.Count == 0)
    {
        <EmptyState Icon="bi-signpost-split"
                    Title="@PathRes.NoPathsYet"
                    ActionHref="/courses"
                    ActionLabel="@PathRes.BrowseCourses" />
    }
    else
    {
        <h2 class="visually-hidden">@PathRes.PathsListHeading</h2>
        <div class="paths-list grid-auto stagger">
            @foreach (var path in _paths)
            {
                <PathCard @key="path.Id" Path="path" />
            }
        </div>
    }
</section>
