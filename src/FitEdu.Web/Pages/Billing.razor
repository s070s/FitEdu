@page "/billing"
@attribute [Authorize]
@using FitEdu.Web.Extensions

<AppPageTitle Text="@BillingRes.PageTitle" />

<div class="billing-page page">
    <header class="billing-header">
        <span class="eyebrow">@BillingRes.Eyebrow</span>
        <h1>@BillingRes.PageHeading</h1>
    </header>

    @if (_loading)
    {
        <LoadingSpinner Label="@BillingRes.LoadingBilling" />
    }
    else if (_error is not null)
    {
        <p class="text-danger">@_error</p>
        <button class="btn btn-secondary" @onclick="LoadBillingOverviewAsync">@GlobalRes.TryAgain</button>
    }
    else if (_overview is not null)
    {
        @* ── Current Plan Card ── *@
        <section class="billing-section" aria-labelledby="billing-current-plan">
            <h2 id="billing-current-plan">@BillingRes.CurrentPlan</h2>
            <div class="current-plan-card card-surface">
                <div class="plan-info">
                    <div class="plan-name-row">
                        <span class="plan-name">@CurrentPlanName</span>
                        <span class="tier-badge chip @TierChipClass(_overview.CurrentSubscription?.Tier)">
                            <span class="bi bi-check-circle-fill" aria-hidden="true"></span>@BillingRes.PlanActive
                        </span>
                    </div>

                    <dl class="plan-dates">
                        <div>
                            <dt>@BillingRes.ActiveSince</dt>
                            <dd>@(_overview.CurrentSubscription is { } current ? SiteClock.ToSiteTime(current.StartedAt).ToString("d") : null)</dd>
                        </div>
                        @if (_overview.CurrentSubscription?.ExpiresAt is not null)
                        {
                            <div>
                                <dt>@BillingRes.NextRenewal</dt>
                                <dd>@SiteClock.ToSiteTime(_overview.CurrentSubscription.ExpiresAt.Value).ToString("d")</dd>
                            </div>
                        }
                        else
                        {
                            <div>
                                <dt>@BillingRes.Renewal</dt>
                                <dd>@BillingRes.NoExpiry</dd>
                            </div>
                        }
                    </dl>

                    @if (_overview.CurrentSubscription?.Features is not null)
                    {
                        <div class="plan-features-summary">
                            <span class="feature-tag chip"><span class="bi bi-check-lg" aria-hidden="true"></span>
                                @CourseLimitLabel(_overview.CurrentSubscription.Features.MaxCourses)
                            </span>
                            @if (_overview.CurrentSubscription.Features.AssessmentAccess)
                            {
                                <span class="feature-tag chip"><span class="bi bi-check-lg" aria-hidden="true"></span>@BillingRes.FeatureAssessments</span>
                            }
                            @if (_overview.CurrentSubscription.Features.CertificateAccess)
                            {
                                <span class="feature-tag chip"><span class="bi bi-check-lg" aria-hidden="true"></span>@BillingRes.FeatureCertificates</span>
                            }
                            @if (_overview.CurrentSubscription.Features.PrioritySupport)
                            {
                                <span class="feature-tag chip"><span class="bi bi-check-lg" aria-hidden="true"></span>@BillingRes.FeaturePrioritySupport</span>
                            }
                        </div>
                    }
                </div>

                <div class="plan-actions">
                    <button class="btn-cta" @onclick="GoToPricing">@BillingRes.ChangePlan</button>
                    @if (_overview.CurrentSubscription?.Tier > SubscriptionTier.Free)
                    {
                        <button class="btn-cta btn-cta--ghost btn-cancel-plan" @onclick="RequestCancel" disabled="@_cancelling">
                            @BillingRes.CancelSubscription
                        </button>
                    }
                </div>

                @if (_cancelMessage is not null)
                {
                    <div class="cancel-msg @(_cancelSuccess ? "msg-success" : "msg-error")">
                        @_cancelMessage
                    </div>
                }

                <ConfirmModal IsVisible="_showCancelConfirm"
                              Title="@BillingRes.CancelConfirmTitle"
                              ConfirmLabel="@BillingRes.CancelSubscription"
                              CancelLabel="@BillingRes.KeepSubscription"
                              ConfirmButtonClass="btn-warning"
                              IsBusy="_cancelling"
                              OnConfirm="CancelSubscription"
                              OnCancel="CloseCancelDialog">
                    <BodyContent>
                        <p>@string.Format(BillingRes.CancelConfirmBody, CurrentPlanName)</p>
                        @if (_overview.CurrentSubscription?.ExpiresAt is not null)
                        {
                            <p class="mb-0">@string.Format(BillingRes.CancelConfirmAccessUntil, SiteClock.ToSiteTime(_overview.CurrentSubscription.ExpiresAt.Value).ToString("d"))</p>
                        }
                    </BodyContent>
                </ConfirmModal>
            </div>
        </section>

        @* ── Transaction History ── *@
        <section class="billing-section" aria-labelledby="billing-history">
            <h2 id="billing-history">@BillingRes.TransactionHistory</h2>

            @if (_overview.Transactions.TotalCount == 0)
            {
                <p class="text-light-muted">@BillingRes.NoTransactions</p>
            }
            else
            {
                <ScrollableTable Items="_overview.Transactions.Items" TItem="BillingTransactionDto"
                                 TableCssClass="transactions-table">
                    <HeaderRow>
                        <tr>
                            <SortableColumnHeader ColumnKey="createdat" Label="@BillingRes.ColDate"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <th>@BillingRes.ColDescription</th>
                            <SortableColumnHeader ColumnKey="plan" Label="@BillingRes.ColPlan"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <SortableColumnHeader ColumnKey="amount" Label="@BillingRes.ColAmount"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <th>@BillingRes.ColReference</th>
                        </tr>
                    </HeaderRow>
                    <RowTemplate Context="tx">
                        <tr @key="tx.Id">
                            <td data-label="@BillingRes.ColDate">@SiteClock.ToSiteTime(tx.CreatedAt).ToString("g")</td>
                            <td data-label="@BillingRes.ColDescription">
                                <span class="tx-type tx-type-@tx.Type.ToLowerInvariant()">@TransactionTypeLabel(tx.Type)</span>
                                @if (ShowTransactionDescription)
                                {
                                    <span class="tx-description">@tx.Description</span>
                                }
                            </td>
                            <td data-label="@BillingRes.ColPlan">@TierLabels.Name(tx.Tier)</td>
                            <td data-label="@BillingRes.ColAmount" class="@(tx.Amount > 0 ? "amount-charge" : "amount-zero")">
                                @if (tx.Amount == 0)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <span>@MoneyFormatter.Format(tx.Amount, tx.Currency)</span>
                                }
                            </td>
                            <td data-label="@BillingRes.ColReference" class="tx-ref">
                                @if (!string.IsNullOrEmpty(tx.StripeSessionId))
                                {
                                    <code>@tx.StripeSessionId[..Math.Min(20, tx.StripeSessionId.Length)]…</code>
                                }
                                else
                                {
                                    <span class="text-light-muted">—</span>
                                }
                            </td>
                        </tr>
                    </RowTemplate>
                </ScrollableTable>

                <AdminPaginationToolbar CurrentPage="_overview.Transactions.Page"
                                        TotalPages="_overview.Transactions.TotalPages"
                                        TotalCount="_overview.Transactions.TotalCount"
                                        PageSize="_overview.Transactions.PageSize"
                                        HasPreviousPage="_overview.Transactions.HasPreviousPage"
                                        HasNextPage="_overview.Transactions.HasNextPage"
                                        PageSizeOptions="PageSizeOptions"
                                        ItemLabel="@BillingRes.ItemLabelTransactions"
                                        OnPageSizeChanged="OnPageSizeChanged"
                                        OnPreviousPage="PreviousPage"
                                        OnNextPage="NextPage" />
            }
        </section>
    }
</div>
