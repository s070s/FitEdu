@page "/profile"
@attribute [Authorize]
@using FitEdu.Web.Extensions

<AppPageTitle Text="@ProfileRes.PageTitle" />

<div class="profile-container page">

    <AuthorizeView>
        <Authorized>
            @if (profile == null)
            {
                <h1>@ProfileRes.Heading</h1>
                @if (_loadError is not null)
                {
                    <p class="text-danger">@_loadError</p>
                    <button class="btn btn-secondary" @onclick="LoadProfileAsync">@GlobalRes.TryAgain</button>
                }
                else
                {
                    <LoadingSpinner Label="@ProfileRes.Loading" />
                }
            }
            else
            {
                <section class="profile-hero card-surface" aria-labelledby="profile-name">
                    <div class="profile-hero__avatar">
                        @if (!string.IsNullOrEmpty(avatarDataUrl))
                        {
                            <img src="@avatarDataUrl" alt="" class="profile-avatar" width="96" height="96" />
                        }
                        else
                        {
                            <span class="profile-avatar profile-avatar--empty bi bi-person-circle" aria-hidden="true"></span>
                        }
                    </div>
                    <div class="profile-hero__text">
                        <span class="eyebrow">@ProfileRes.Heading</span>
                        <h1 id="profile-name" class="profile-hero__name">@HeroName</h1>
                        <p class="profile-hero__email">@profile.Email</p>
                        @if (HasLevelChip || profile.Goal is not null)
                        {
                            <div class="chip-row">
                                @if (HasLevelChip)
                                {
                                    <span class="chip chip--lime"><span class="bi bi-bar-chart-steps" aria-hidden="true"></span>@UserStatusLabels.Label(profile.Status)</span>
                                }
                                @if (profile.Goal is { } goal)
                                {
                                    <span class="chip chip--teal"><span class="bi bi-bullseye" aria-hidden="true"></span>@CourseLabels.Goal(goal)</span>
                                }
                            </div>
                        }
                    </div>
                </section>

                @if (HasAnyStat)
                {
                    <section class="profile-stats" aria-labelledby="profile-stats-heading">
                        <h2 id="profile-stats-heading" class="visually-hidden">@ProfileRes.StatsHeading</h2>
                        @if (_enrolledCourses is { } courses)
                        {
                            <StatTile Value="@courses.ToString()" Label="@ProfileRes.StatsCourses" Icon="bi-collection-play" />
                        }
                        @if (_certificates is { } certificates)
                        {
                            <StatTile Value="@certificates.ToString()" Label="@ProfileRes.StatsCertificates" Icon="bi-award" />
                        }
                        @if (_assessments is { } assessments)
                        {
                            <StatTile Value="@assessments.ToString()" Label="@ProfileRes.StatsAssessments" Icon="bi-clipboard-check" />
                        }
                    </section>
                }

                <FormCardSection Title="@ProfileRes.BasicInformation"
                                 IsCollapsible="true"
                                 InitiallyExpanded="true"
                                 CssClass="card mb-3">
                    <ChildContent>
                        <div class="mb-3">
                            <label class="form-label" for="profile-avatar">@ProfileRes.LabelAvatar</label>
                            <div>
                                <FilePicker Id="profile-avatar" OnChange="HandleAvatarUpload" Accept="image/*" Disabled="_uploadingAvatar" />
                                @if (_uploadingAvatar)
                                {
                                    <div class="mt-2 d-flex align-items-center gap-2">
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>@ProfileRes.UploadingAvatar</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="profile-display-name">@ProfileRes.LabelDisplayName</label>
                            <input id="profile-display-name" type="text" class="form-control" @bind="displayName" placeholder="@profile.Email" />
                        </div>

                        <div class="profile-fields-row">
                            <div class="mb-3">
                                <label class="form-label" for="profile-status">@GlobalRes.Label_Info_Status</label>
                                <select id="profile-status" class="form-select" @bind="profileStatus">
                                    @* A member who never picked a level gets a visible "not chosen" option, not a blank box. *@
                                    @if (profileStatus == UserStatus.Unknown)
                                    {
                                        <option value="@UserStatus.Unknown">@ProfileRes.GoalNotSet</option>
                                    }
                                    @foreach (var status in UserStatusLabels.Selectable)
                                    {
                                        <option value="@status">@UserStatusLabels.Label(status)</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="profile-goal">@ProfileRes.Goal</label>
                                <select id="profile-goal" class="form-select" @bind="profileGoal">
                                    <option value="">@ProfileRes.GoalNotSet</option>
                                    @foreach (var goal in Enum.GetValues<FitnessGoal>())
                                    {
                                        <option value="@goal">@CourseLabels.Goal(goal)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <dl class="profile-facts">
                            <div><dt>@ProfileRes.LabelEmail</dt><dd>@profile.Email</dd></div>
                            <div><dt>@ProfileRes.LabelName</dt><dd>@profile.FirstName @profile.LastName</dd></div>
                            <div><dt>@ProfileRes.LabelDateOfBirth</dt><dd>@(profile.DateOfBirth?.ToString("d") ?? ProfileRes.NotSpecified)</dd></div>
                        </dl>

                        <button type="button" class="btn-cta" @onclick="UpdateProfile" disabled="@isSaving">@ProfileRes.BtnSaveProfile</button>
                    </ChildContent>
                </FormCardSection>

                <FormCardSection Title="@ProfileRes.ChangePassword"
                                 IsCollapsible="true"
                                 InitiallyExpanded="false"
                                 CssClass="card mb-3">
                    <ChildContent>
                        <form @onsubmit="ChangePassword" @onsubmit:preventDefault="true">
                            <div class="mb-3">
                                <label class="form-label" for="profile-current-password">@ProfileRes.LabelCurrentPassword</label>
                                <input id="profile-current-password" type="password" class="form-control" autocomplete="current-password" @bind="currentPassword" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="profile-new-password">@ProfileRes.LabelNewPassword</label>
                                <input id="profile-new-password" type="password" class="form-control" autocomplete="new-password"
                                       aria-describedby="profile-password-help" @bind="newPassword" />
                                <div class="form-text" id="profile-password-help">@GlobalRes.PasswordRulesHint</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="profile-confirm-password">@ProfileRes.LabelConfirmNewPassword</label>
                                <input id="profile-confirm-password" type="password" class="form-control" autocomplete="new-password" @bind="confirmPassword" />
                            </div>
                            <button type="submit" class="btn-cta" disabled="@isChangingPassword">@ProfileRes.ChangePassword</button>
                        </form>
                    </ChildContent>
                </FormCardSection>

                <FormCardSection Title="@ProfileRes.YourData"
                                 IsCollapsible="true"
                                 InitiallyExpanded="false"
                                 CssClass="card mb-3">
                    <ChildContent>
                        <p>@ProfileRes.DownloadMyDataDescription</p>
                        <a class="btn btn-outline-primary" href="api/profile/export">@ProfileRes.DownloadMyData</a>
                    </ChildContent>
                </FormCardSection>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert alert-info">@message</div>
                }

                @if (!_isImpersonating)
                {
                    <button type="button" class="btn-cta btn-cta--ghost profile-logout" @onclick="Logout">@ProfileRes.BtnLogout</button>

                    <FormCardSection Title="@ProfileRes.DangerZone"
                                     IsCollapsible="true"
                                     InitiallyExpanded="false"
                                     CssClass="card mb-3 mt-3">
                        <ChildContent>
                            <p>@ProfileRes.DeleteAccountDescription</p>
                            @if (_deleteError is not null)
                            {
                                <div class="alert alert-danger">@_deleteError</div>
                            }
                            <button class="btn btn-danger" @onclick="RequestDeleteAccount" disabled="@_isDeleting">@ProfileRes.DeleteAccount</button>
                        </ChildContent>
                    </FormCardSection>

                    <ConfirmModal IsVisible="_showDeleteConfirm"
                                  Title="@ProfileRes.DeleteAccountConfirmTitle"
                                  Message="@ProfileRes.DeleteAccountConfirmBody"
                                  ConfirmLabel="@ProfileRes.DeleteAccount"
                                  CancelLabel="@GlobalRes.Cancel"
                                  IsBusy="_isDeleting"
                                  OnConfirm="DeleteAccount"
                                  OnCancel="CloseDeleteDialog" />
                }
            }
        </Authorized>
        <NotAuthorized>
            <p>@ProfileRes.RedirectingToLogin</p>
        </NotAuthorized>
    </AuthorizeView>
</div>

