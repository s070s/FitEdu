@page "/pricing"
@using FitEdu.Web.Extensions

<PageTitle>@PricingRes.PageTitle</PageTitle>
<SeoHead Title="@PricingRes.PageTitle"
         Description="@PricingRes.Subtitle"
         CanonicalUrl="/pricing" />

<div class="pricing-page page">
    <header class="pricing-header">
        <span class="eyebrow">@PricingRes.Eyebrow</span>
        <h1>@PricingRes.Heading</h1>
        <p class="pricing-subtitle">@PricingRes.Subtitle</p>
    </header>

    <AuthorizeView>
        <Authorized>
            @if (_currentStatus is not null)
            {
                <div class="current-plan-banner">
                    <span class="bi bi-patch-check-fill" aria-hidden="true"></span>
                    <span>@PricingRes.CurrentPlanLabel <strong>@_currentStatus.PlanName</strong></span>
                </div>
            }
        </Authorized>
    </AuthorizeView>

    @if (_loading)
    {
        <LoadingSpinner Label="@PricingRes.LoadingPlans" />
    }
    else if (_error is not null)
    {
        <p class="text-danger">@_error</p>
    }
    else
    {
        <div class="pricing-grid">
            @foreach (var plan in _plans)
            {
                var isCurrent = _currentStatus?.PlanName == plan.Name;
                var isUpgrade = _currentStatus is not null && plan.Tier > _currentStatus.Tier;

                <article class="plan-card card-surface @(IsFeatured(plan) ? "plan-featured" : "") @(isCurrent ? "plan-current" : "")"
                         aria-labelledby="plan-name-@plan.Id">
                    @if (IsFeatured(plan))
                    {
                        <div class="plan-badge"><span class="bi bi-lightning-charge-fill" aria-hidden="true"></span> @PricingRes.MostPopular</div>
                    }
                    <h2 class="plan-name" id="plan-name-@plan.Id">@plan.Name</h2>
                    <div class="plan-price">
                        @if (plan.Price == 0)
                        {
                            <span class="price-amount">@PricingRes.PriceFree</span>
                        }
                        else
                        {
                            <span class="price-amount">@MoneyFormatter.Format(plan.Price)</span>
                            <span class="price-period">@PeriodLabel(plan.BillingPeriod)</span>
                        }
                    </div>
                    <p class="plan-description">@plan.Description</p>

                    @if (plan.Features is not null)
                    {
                        <ul class="plan-features" aria-label="@string.Format(PricingRes.FeaturesListLabel, plan.Name)">
                            <li class="feature-item">
                                <span class="feature-icon bi bi-check-lg" aria-hidden="true"></span>
                                <span>@CourseAccessLabel(plan.Tier)</span>
                            </li>
                            <li class="feature-item">
                                <span class="feature-icon bi bi-check-lg" aria-hidden="true"></span>
                                <span>@(plan.Features.MaxCourses >= UnlimitedCoursesThreshold ? PricingRes.UnlimitedCourses : string.Format(PricingRes.UpToCoursesFormat, plan.Features.MaxCourses))</span>
                            </li>
                            <li class="feature-item">
                                <span class="feature-icon bi bi-check-lg" aria-hidden="true"></span>
                                <span>@PricingRes.FeatureExerciseLibrary</span>
                            </li>
                            <li class="feature-item">
                                <span class="feature-icon bi bi-check-lg" aria-hidden="true"></span>
                                <span>@PricingRes.FeatureLiveClasses</span>
                            </li>
                            @FeatureRow(plan.Features.AssessmentAccess, PricingRes.FeatureAssessmentAccess)
                            @FeatureRow(plan.Features.CertificateAccess, PricingRes.FeatureCertificates)
                            @FeatureRow(plan.Features.PrioritySupport, PricingRes.FeaturePrioritySupport)
                        </ul>
                    }

                    <AuthorizeView>
                        <Authorized>
                            @if (isCurrent)
                            {
                                <button class="btn-plan btn-current" disabled>@PricingRes.BtnCurrentPlan</button>
                            }
                            else if (isUpgrade)
                            {
                                <button class="btn-plan btn-upgrade" @onclick="() => Checkout(plan.Id)" disabled="@_processing">
                                    @(_processing ? PricingRes.Processing : PricingRes.BtnUpgrade)
                                </button>
                            }
                            else if (plan.Tier == SubscriptionTier.Free && _currentStatus is not null && _currentStatus.Tier > SubscriptionTier.Free)
                            {
                                <button class="btn-plan btn-downgrade" @onclick="RequestCancel" disabled="@_processing">
                                    @(_processing ? PricingRes.Processing : PricingRes.BtnDowngradeToFree)
                                </button>
                            }
                            else if (plan.Price == 0)
                            {
                                <button class="btn-plan btn-free" disabled>@PricingRes.BtnIncluded</button>
                            }
                            else
                            {
                                <button class="btn-plan btn-select" @onclick="() => Checkout(plan.Id)" disabled="@_processing">
                                    @(_processing ? PricingRes.Processing : PricingRes.BtnSelectPlan)
                                </button>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <button class="btn-plan btn-select" @onclick="NavigateToRegister">
                                @PricingRes.BtnGetStarted
                            </button>
                        </NotAuthorized>
                    </AuthorizeView>
                </article>
            }
        </div>

        <p class="pricing-footnote">@PricingRes.Footnote</p>

        @if (_cancelMessage is not null)
        {
            <div class="cancel-message @(_cancelSuccess ? "cancel-success" : "cancel-error")">
                @_cancelMessage
            </div>
        }

        <ConfirmModal IsVisible="_showCancelConfirm"
                      Title="@BillingRes.CancelConfirmTitle"
                      ConfirmLabel="@BillingRes.CancelSubscription"
                      CancelLabel="@BillingRes.KeepSubscription"
                      ConfirmButtonClass="btn-warning"
                      IsBusy="_processing"
                      OnConfirm="CancelSubscription"
                      OnCancel="CloseCancelDialog">
            <BodyContent>
                <p>@string.Format(BillingRes.CancelConfirmBody, _currentStatus?.PlanName)</p>
                @if (_currentStatus?.ExpiresAt is not null)
                {
                    <p class="mb-0">@string.Format(BillingRes.CancelConfirmAccessUntil, _currentStatus.ExpiresAt.Value.ToLocalTime().ToString("d"))</p>
                }
            </BodyContent>
        </ConfirmModal>
    }
</div>


@code {
    /// <summary>A plan feature the plan may or may not include: a tick, or a cross with hidden "Not included" text.</summary>
    private static RenderFragment FeatureRow(bool included, string label) =>
        @<li class="feature-item @(included ? "" : "feature-disabled")">
            <span class="feature-icon bi @FeatureIcon(included)" aria-hidden="true"></span>
            @if (!included)
            {
                <span class="visually-hidden">@PricingRes.FeatureNotIncluded</span>
            }
            <span>@label</span>
        </li>;
}
