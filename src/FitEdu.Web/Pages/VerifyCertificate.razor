@page "/certificate/{VerificationId:guid}"

<PageTitle>@CertificateRes.VerificationTitle</PageTitle>

@if (_loading)
{
    <LoadingSpinner Label="@CertificateRes.VerificationChecking" />
}
else if (_result is null)
{
    <StatusPanel Icon="bi-wifi-off"
                 Title="@CertificateRes.VerificationTitle"
                 Lead="@CertificateRes.VerificationUnreachable">
        <Actions>
            <a href="/" class="btn-cta btn-cta--ghost">@GlobalRes.BackToHome</a>
        </Actions>
    </StatusPanel>
}
else if (_result.IsValid)
{
    <StatusPanel Icon="bi-patch-check-fill"
                 Tone="StatusPanel.StatusTone.Success"
                 Eyebrow="@CertificateRes.VerificationTitle"
                 Title="@CertificateRes.VerificationValid">
        <ChildContent>
            <dl class="certificate-details">
                <div>
                    <dt>@CertificateRes.FieldRecipient</dt>
                    <dd>@_result.RecipientName</dd>
                </div>
                <div>
                    <dt>@CertificateRes.FieldCourse</dt>
                    <dd>@_result.CourseTitle</dd>
                </div>
                <div>
                    <dt>@CertificateRes.FieldIssuedOn</dt>
                    <dd>@(_result.IssuedAt is { } issuedAt ? SiteClock.ToSiteTime(issuedAt).ToString("d") : null)</dd>
                </div>
            </dl>
        </ChildContent>
        <Actions>
            <a href="/" class="btn-cta btn-cta--ghost">@GlobalRes.BackToHome</a>
        </Actions>
    </StatusPanel>
}
else
{
    <StatusPanel Icon="bi-x-octagon-fill"
                 Tone="StatusPanel.StatusTone.Danger"
                 Eyebrow="@CertificateRes.VerificationTitle"
                 Title="@CertificateRes.VerificationInvalid"
                 Lead="@InvalidLead">
        <Actions>
            <a href="/" class="btn-cta btn-cta--ghost">@GlobalRes.BackToHome</a>
        </Actions>
    </StatusPanel>
}
