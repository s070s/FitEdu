@page "/terms"

<PageTitle>@LegalRes.TermsTitle</PageTitle>

<LegalDocument Title="@LegalRes.TermsTitle"
               Intro="@LegalRes.TermsIntro"
               CanonicalPath="/terms"
               Sections="Sections"
               OtherDocumentHref="/privacy"
               OtherDocumentTitle="@LegalRes.PrivacyTitle" />

@code {
    private static IReadOnlyList<LegalDocument.Section> Sections =>
    [
        new(LegalRes.TermsServiceTitle, LegalRes.TermsServiceBody),
        new(LegalRes.TermsAccountsTitle, LegalRes.TermsAccountsBody),
        new(LegalRes.TermsAcceptableTitle, LegalRes.TermsAcceptableBody),
        new(LegalRes.TermsContentTitle, LegalRes.TermsContentBody),
        new(LegalRes.TermsAssessmentsTitle, LegalRes.TermsAssessmentsBody),
        new(LegalRes.TermsDisclaimerTitle, LegalRes.TermsDisclaimerBody),
        new(LegalRes.TermsChangesTitle, LegalRes.TermsChangesBody)
    ];
}
