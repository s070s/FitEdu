@page "/reset-password"

<AppPageTitle Text="@GlobalRes.ResetPasswordTitle" />

@* The link in the reset email (built by AuthLinks) carries the email and the one-time token. *@
<AuthCard Title="@GlobalRes.ResetPasswordTitle" Subtitle="@(CurrentStep == Step.Ready ? GlobalRes.ResetPasswordInstructions : null)">
    <ChildContent>
        @if (CurrentStep == Step.Done)
        {
            <div class="alert alert-success" role="status">@SuccessMessagesRes.PasswordResetSuccessful</div>
            <a class="btn-cta auth-submit" href="/login">@GlobalRes.Label_GoToLogin</a>
        }
        else if (CurrentStep == Step.LinkInvalid)
        {
            <div class="alert alert-danger" role="alert">@ErrorMessagesRes.PasswordResetLinkInvalid</div>
            <a class="btn-cta auth-submit" href="/forgot-password">@GlobalRes.Label_RequestNewLink</a>
        }
        else
        {
            @if (errors.Count > 0)
            {
                <div class="alert alert-danger" role="alert">
                    <ul class="mb-0">
                        @foreach (var error in errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <EditForm Model="resetRequest" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @* The account the new password is for, read-only: password managers save it under this email. *@
                <div class="mb-3">
                    <label for="email" class="form-label">@GlobalRes.Label_Info_Email</label>
                    <input id="email" type="email" class="form-control" autocomplete="username" readonly value="@resetRequest.Email" />
                </div>

                <div class="mb-3">
                    <label for="newPassword" class="form-label">@GlobalRes.Label_NewPassword</label>
                    <div class="input-group">
                        <InputText id="newPassword" type="@newPasswordInputType" class="form-control" autocomplete="new-password" aria-describedby="password-help" @bind-Value="resetRequest.NewPassword" />
                        <button type="button" class="btn btn-password-toggle" @onclick="ToggleNewPasswordVisibility"
                                aria-label="@GlobalRes.ShowHidePassword"
                                aria-pressed="@(showNewPassword ? "true" : "false")">
                            <i class="@(showNewPassword ? "bi bi-eye-slash" : "bi bi-eye")" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="form-text" id="password-help">@GlobalRes.PasswordRulesHint</div>
                    <ValidationMessage For="@(() => resetRequest.NewPassword)" />
                </div>

                <div class="mb-3">
                    <label for="confirmPassword" class="form-label">@GlobalRes.Label_ConfirmPassword</label>
                    <div class="input-group">
                        <InputText id="confirmPassword" type="@confirmPasswordInputType" class="form-control" autocomplete="new-password" @bind-Value="resetRequest.ConfirmPassword" />
                        <button type="button" class="btn btn-password-toggle" @onclick="ToggleConfirmPasswordVisibility"
                                aria-label="@GlobalRes.ShowHidePassword"
                                aria-pressed="@(showConfirmPassword ? "true" : "false")">
                            <i class="@(showConfirmPassword ? "bi bi-eye-slash" : "bi bi-eye")" aria-hidden="true"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => resetRequest.ConfirmPassword)" />
                </div>

                <button type="submit" class="btn-cta auth-submit" disabled="@isSaving">
                    @if (isSaving) { <span>@GlobalRes.Label_Saving</span> } else { <span>@GlobalRes.Label_SetNewPassword</span> }
                </button>
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <a href="/login"><span class="bi bi-arrow-left" aria-hidden="true"></span> @ErrorMessagesRes.BackToLogin</a>
    </Footer>
</AuthCard>
