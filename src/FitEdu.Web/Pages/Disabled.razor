@page "/disabled"

<PageTitle>@ErrorMessagesRes.AccountDisabled</PageTitle>

<StatusPanel Icon="bi-person-lock"
             Tone="StatusPanel.StatusTone.Danger"
             Title="@ErrorMessagesRes.AccountDisabled"
             Lead="@ErrorMessagesRes.AccountDisabledMessage">
    <ChildContent>
        <p class="text-light-muted mb-0">@ErrorMessagesRes.AccountDisabledContact</p>
    </ChildContent>
    <Actions>
        <a href="/login" class="btn-cta">@ErrorMessagesRes.BackToLogin</a>
    </Actions>
</StatusPanel>
