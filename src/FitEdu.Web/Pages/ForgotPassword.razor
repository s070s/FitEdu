@page "/forgot-password"

<AppPageTitle Text="@GlobalRes.ForgotPasswordTitle" />

@* The instructions describe the form, so they go once the link is sent and the form is gone. *@
<AuthCard Title="@GlobalRes.ForgotPasswordTitle" Subtitle="@(string.IsNullOrEmpty(successMessage) ? GlobalRes.ForgotPasswordInstructions : null)">
    <ChildContent>
        @* Both regions are always on the page, empty until needed: a screen reader announces text that
           appears in a region that was already there, not a new alert that is added whole. *@
        <div role="status">
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success" tabindex="-1" @ref="resultRegion">@successMessage</div>
            }
        </div>

        <div role="alert">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
        </div>

        @if (string.IsNullOrEmpty(successMessage))
        {
            @* A plain text input (not type="email" or required): the browser's own message is not in the page's language,
               so the translated attribute messages of the DTO are shown instead, as on the other forms. *@
            <EditForm Model="@forgotPasswordRequest" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="email" class="form-label">@GlobalRes.Label_Info_Email</label>
                    <InputText id="email" inputmode="email" class="form-control" autocomplete="email" @bind-Value="forgotPasswordRequest.Email" />
                    <ValidationMessage For="@(() => forgotPasswordRequest.Email)" />
                </div>

                <button type="submit" class="btn-cta auth-submit" disabled="@isLoading">
                    @if (isLoading) { <span>@GlobalRes.Label_Sending</span> } else { <span>@GlobalRes.Label_SendResetLink</span> }
                </button>
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <a href="/login"><span class="bi bi-arrow-left" aria-hidden="true"></span> @ErrorMessagesRes.BackToLogin</a>
    </Footer>
</AuthCard>
