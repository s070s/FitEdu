@page "/forgot-password"

<AppPageTitle Text="@GlobalRes.ForgotPasswordTitle" />

@* The instructions describe the form, so they go once the link is sent and the form is gone. *@
<AuthCard Title="@GlobalRes.ForgotPasswordTitle" Subtitle="@(string.IsNullOrEmpty(successMessage) ? GlobalRes.ForgotPasswordInstructions : null)">
    <ChildContent>
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">
                @successMessage
                @* The direct reset calls a Development-only endpoint, so it is offered only there. *@
                @if (Env.IsDevelopment())
                {
                    <div class="mt-3">
                        <p class="mb-2"><strong>@GlobalRes.Label_DevMode</strong> @GlobalRes.DevResetPasswordHint</p>
                        <input type="password" class="form-control mb-2" @bind="devNewPassword" placeholder="@GlobalRes.Label_NewPassword"
                               aria-label="@GlobalRes.Label_NewPassword" autocomplete="new-password" />
                        <button class="btn btn-sm btn-warning" @onclick="DevResetPassword">@GlobalRes.Label_DevResetPassword</button>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (string.IsNullOrEmpty(successMessage))
        {
            <EditForm Model="@forgotPasswordRequest" OnValidSubmit="HandleSubmit">
                <div class="mb-3">
                    <label for="email" class="form-label">@GlobalRes.Label_Info_Email</label>
                    <input type="email" id="email" class="form-control" autocomplete="email" @bind="forgotPasswordRequest.Email" required />
                </div>

                <button type="submit" class="btn-cta auth-submit" disabled="@isLoading">
                    @if (isLoading) { <span>@GlobalRes.Label_Sending</span> } else { <span>@GlobalRes.Label_SendResetLink</span> }
                </button>
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <a href="/login"><span class="bi bi-arrow-left" aria-hidden="true"></span> @ErrorMessagesRes.BackToLogin</a>
    </Footer>
</AuthCard>
