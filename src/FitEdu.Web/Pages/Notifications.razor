@page "/notifications"
@attribute [Authorize]
@using System.Globalization
@using FitEdu.Web.Extensions

<AppPageTitle Text="@NotificationRes.PageTitle" />

<div class="page notifications-page">
    <header class="notifications-head">
        <div class="notifications-head__text">
            <span class="eyebrow"><span class="bi @AppIcons.Notification" aria-hidden="true"></span> @NavMenuRes.Notifications</span>
            <h1>@NotificationRes.Heading</h1>
            <p class="notifications-head__lead">@NotificationRes.Subtitle</p>
        </div>

        @if (pagedResult is { Items.Count: > 0 })
        {
            <div class="notifications-head__actions">
                <label class="visually-hidden" for="notification-sort">@NotificationRes.SortLabel</label>
                <select id="notification-sort" class="form-select notifications-sort" value="@SelectedSortOption" @onchange="OnSortChanged">
                    <option value="@SortNewest">@NotificationRes.SortNewest</option>
                    <option value="@SortOldest">@NotificationRes.SortOldest</option>
                    <option value="@SortUnreadFirst">@NotificationRes.SortUnreadFirst</option>
                </select>
                @if (pagedResult.Items.Any(notification => !notification.IsRead))
                {
                    <button type="button" class="btn-cta btn-cta--ghost notifications-mark-all" @onclick="MarkAllReadAsync">
                        <span class="bi bi-check2-all" aria-hidden="true"></span> @NotificationRes.MarkAllRead
                    </button>
                }
            </div>
        }
    </header>

    @if (pagedResult == null)
    {
        <LoadingSpinner Label="@NotificationRes.Loading" />
    }
    else if (!pagedResult.Items.Any())
    {
        <EmptyState Icon="bi-bell" Title="@NotificationRes.Empty" />
    }
    else
    {
        <ul class="notification-feed">
            @foreach (var notification in pagedResult.Items)
            {
                <li class="notification-row @(notification.IsRead ? "" : "notification-row--unread")" @key="notification.Id">
                    <span class="notification-row__icon" aria-hidden="true"><span class="bi @IconFor(notification.Type)"></span></span>

                    <div class="notification-row__body">
                        <p class="notification-row__message">
                            @if (!string.IsNullOrEmpty(notification.LinkUrl))
                            {
                                <a href="@notification.LinkUrl">@NotificationMessageFormatter.Format(notification)</a>
                            }
                            else
                            {
                                @NotificationMessageFormatter.Format(notification)
                            }
                        </p>
                        <p class="notification-row__meta">
                            <time datetime="@notification.CreatedAt.ToString("o", CultureInfo.InvariantCulture)"
                                  title="@SiteClock.ToSiteTime(notification.CreatedAt).ToString("g")">@RelativeTimeFormatter.NotificationAge(notification.CreatedAt)</time>
                            @if (!notification.IsRead)
                            {
                                <span class="notification-row__unread">@NotificationRes.StatusUnread</span>
                            }
                        </p>
                    </div>

                    @if (!notification.IsRead)
                    {
                        <button type="button" class="notification-row__mark" @onclick="() => MarkReadAsync(notification.Id)"
                                title="@NotificationRes.MarkRead" aria-label="@NotificationRes.MarkRead">
                            <span class="bi bi-check2" aria-hidden="true"></span>
                        </button>
                    }
                </li>
            }
        </ul>

        <AdminPaginationToolbar CurrentPage="pagedResult.Page"
                                TotalPages="pagedResult.TotalPages"
                                TotalCount="pagedResult.TotalCount"
                                PageSize="pagedResult.PageSize"
                                HasPreviousPage="pagedResult.HasPreviousPage"
                                HasNextPage="pagedResult.HasNextPage"
                                PageSizeOptions="PageSizeOptions"
                                ItemLabel="@NotificationRes.Title"
                                OnPageSizeChanged="OnPageSizeChanged"
                                OnPreviousPage="PreviousPage"
                                OnNextPage="NextPage" />
    }
</div>
