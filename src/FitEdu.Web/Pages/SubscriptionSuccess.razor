@page "/subscription/success"
@attribute [Authorize]

<PageTitle>@SubscriptionSuccessRes.PageTitle</PageTitle>

<div class="success-page page">
    @if (_loading)
    {
        <LoadingSpinner Label="@SubscriptionSuccessRes.LoadingSubscription" />
    }
    else if (_status is not null)
    {
        <section class="success-card card-surface" aria-labelledby="success-heading">
            <div class="success-icon" aria-hidden="true"><span class="bi bi-trophy-fill"></span></div>
            <span class="eyebrow">@SubscriptionSuccessRes.Eyebrow</span>
            <h1 id="success-heading">@string.Format(SubscriptionSuccessRes.PlanHeadingFormat, TierLabels.Name(_status.Tier))</h1>
            <p class="success-lead">@SubscriptionSuccessRes.SubscriptionActive</p>

            <dl class="plan-details">
                <div>
                    <dt>@SubscriptionSuccessRes.LabelPlan</dt>
                    <dd>@TierLabels.Name(_status.Tier)</dd>
                </div>
                <div>
                    <dt>@SubscriptionSuccessRes.LabelStarted</dt>
                    <dd>@SiteClock.ToSiteTime(_status.StartedAt).ToString("d")</dd>
                </div>
                @if (_status.ExpiresAt.HasValue)
                {
                    <div>
                        <dt>@SubscriptionSuccessRes.LabelRenews</dt>
                        <dd>@SiteClock.ToSiteTime(_status.ExpiresAt.Value).ToString("d")</dd>
                    </div>
                }
            </dl>

            <div class="success-actions">
                <button class="btn-cta" @onclick="GoToCourses">@SubscriptionSuccessRes.BtnBrowseCourses</button>
                <button class="btn-cta btn-cta--ghost" @onclick="GoToPricing">@SubscriptionSuccessRes.BtnViewPlans</button>
            </div>
        </section>
    }
    else
    {
        <section class="success-card card-surface success-card--error" aria-labelledby="success-error">
            <div class="success-icon success-icon--muted" aria-hidden="true"><span class="bi bi-exclamation-circle"></span></div>
            <p id="success-error" class="success-lead">@SubscriptionSuccessRes.UnableToLoad</p>
            <div class="success-actions">
                <button class="btn-cta btn-cta--ghost" @onclick="GoToPricing">@SubscriptionSuccessRes.BtnBackToPricing</button>
            </div>
        </section>
    }
</div>
