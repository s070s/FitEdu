@page "/not-found"

@* Routable NotFoundPage target (required since .NET 10 — the Router's inline <NotFound>
   render fragment is no longer supported; unmatched hard-navigation requests only reach this
   page via Program.cs's UseStatusCodePagesWithReExecute("/not-found") re-execute). *@

<AppPageTitle Text="@GlobalRes.NotFoundTitle" />

<StatusPanel Icon="bi-signpost-split"
             Eyebrow="404"
             Title="@GlobalRes.NotFoundTitle"
             Lead="@GlobalRes.NotFoundMessage">
    <Actions>
        <a href="/" class="btn-cta">@GlobalRes.BackToHome</a>
    </Actions>
</StatusPanel>
