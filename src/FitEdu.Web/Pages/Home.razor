@page "/"
@using FitEdu.Web.Extensions

<PageTitle>@HomeRes.PageTitle</PageTitle>
@* The default description (hero subtitle) and share image are the home ones. *@
@* Guests see the hero photo first, so the browser fetches it before anything else. *@
<SeoHead Title="@HomeRes.PageTitle" CanonicalUrl="/" PreloadImageUrl="@(_isAuthenticated ? null : HeroImageUrl)" />

@if (_isAuthenticated)
{
    <div class="page dashboard">
        <header class="dashboard-head">
            <p class="eyebrow">@TodayLabel</p>
            <h1 class="dashboard-title">@string.Format(HomeRes.WelcomeUser, _authenticatedUserName)</h1>
        </header>

        @if (_isStudent)
        {
            @if (_dashboardLoading)
            {
                <SkeletonBlock Rows="2" Height="9rem" Gap="1rem" />
            }
            else
            {
                @StudentDashboard
            }
        }

        <AuthorizeView>
            <Authorized>
                <section class="dashboard-section" aria-labelledby="explore-title">
                    <h2 id="explore-title" class="dashboard-section__title">@HomeRes.DashboardExplore</h2>
                    <ul class="explore-grid">
                        @foreach (var item in ExploreItems(context.User))
                        {
                            <li>
                                <a class="explore-tile" href="@item.Href">
                                    <span class="explore-tile__icon bi @item.Icon" aria-hidden="true"></span>
                                    <span class="explore-tile__label">@item.Label()</span>
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            </Authorized>
        </AuthorizeView>
    </div>
}
else
{
    <section class="hero-section" aria-labelledby="hero-title">
        <img class="hero-section__photo" src="@HeroImageUrl" alt="" width="1920" height="1440"
             fetchpriority="high" decoding="async" />
        <div class="hero-section__shade" aria-hidden="true"></div>

        <div class="page hero-content">
            <p class="eyebrow hero-eyebrow">@HomeRes.HeroEyebrow</p>
            <h1 id="hero-title" class="hero-title">
                @HomeRes.HeroTitleLine1
                <span class="text-volt">@HomeRes.HeroTitleLine2</span>
            </h1>
            <p class="hero-subtitle">@HomeRes.HeroSubtitle</p>
            <div class="hero-cta">
                <a class="btn-cta btn-cta--large" href="/register">
                    @HomeRes.HeroCtaButton <span class="bi bi-arrow-right" aria-hidden="true"></span>
                </a>
                <a class="btn-cta btn-cta--ghost btn-cta--large" href="/exercises">
                    <span class="bi bi-activity" aria-hidden="true"></span> @HomeRes.HeroCtaSecondary
                </a>
            </div>
        </div>
    </section>

    @if (_landing is not null)
    {
        <section class="page stats-strip" aria-label="@HomeRes.StatsAriaLabel">
            <StatTile Value="@Number(_landing.CourseCount)" Label="@HomeRes.StatsCourses" Icon="bi-collection-play" />
            <StatTile Value="@Number(_landing.ExerciseCount)" Label="@HomeRes.StatsExercises" Icon="bi-activity" />
            <StatTile Value="@Number(_landing.LessonCount)" Label="@HomeRes.StatsLessons" Icon="bi-stopwatch" />
            @if (ShowMemberCount)
            {
                <StatTile Value="@Number(_landing.MemberCount)" Label="@HomeRes.StatsMembers" Icon="bi-people" />
            }
        </section>
    }

    <section class="page home-section" aria-labelledby="goals-title">
        <h2 id="goals-title" class="section-title">
            @HomeRes.GoalsTitle <span class="text-volt">@HomeRes.GoalsTitleHighlight</span>
        </h2>
        <ul class="goal-grid">
            @foreach (var choice in GoalChoices)
            {
                <li>
                    <a class="goal-card" href="@GoalUrl(choice.Goal)">
                        <span class="goal-card__icon bi @choice.Icon" aria-hidden="true"></span>
                        <span class="goal-card__label">@CourseLabels.Goal(choice.Goal)</span>
                        <span class="goal-card__arrow bi bi-arrow-right" aria-hidden="true"></span>
                    </a>
                </li>
            }
        </ul>
    </section>

    <section class="page home-section" aria-labelledby="how-title">
        <h2 id="how-title" class="section-title">
            @HomeRes.HowTitle <span class="text-volt">@HomeRes.HowTitleHighlight</span>
        </h2>
        <ol class="how-steps">
            <li class="how-step">
                <span class="how-step__icon bi bi-clipboard2-pulse" aria-hidden="true"></span>
                <h3 class="how-step__title">@HomeRes.HowStep1Title</h3>
                <p class="how-step__text">@HomeRes.HowStep1Text</p>
            </li>
            <li class="how-step">
                <span class="how-step__icon bi bi-list-check" aria-hidden="true"></span>
                <h3 class="how-step__title">@HomeRes.HowStep2Title</h3>
                <p class="how-step__text">@HomeRes.HowStep2Text</p>
            </li>
            <li class="how-step">
                <span class="how-step__icon bi bi-graph-up-arrow" aria-hidden="true"></span>
                <h3 class="how-step__title">@HomeRes.HowStep3Title</h3>
                <p class="how-step__text">@HomeRes.HowStep3Text</p>
            </li>
        </ol>
    </section>

    @if (_landing is { FeaturedCourses.Count: > 0 })
    {
        <section class="page home-section section-featured" aria-labelledby="featured-title">
            <div class="section-head">
                <h2 id="featured-title" class="section-title">
                    @HomeRes.FeaturedTitle <span class="text-volt">@HomeRes.FeaturedTitleHighlight</span>
                </h2>
                <a class="section-link" href="/courses">
                    @HomeRes.FeaturedSeeAll <span class="bi bi-arrow-right" aria-hidden="true"></span>
                </a>
            </div>
            @* A swipeable row on phones like the member stories, so the landing stays short. *@
            <div class="featured-grid" role="region" tabindex="0" aria-labelledby="featured-title">
                @foreach (var course in _landing.FeaturedCourses)
                {
                    <CourseCard Course="course" @key="course.Id" />
                }
            </div>
        </section>
    }

    @if (_testimonialsLoading)
    {
        <section class="page home-section section-story" aria-labelledby="stories-title">
            <h2 id="stories-title" class="section-title">
                @HomeRes.TestimonialsTitle <span class="text-volt">@HomeRes.TestimonialsTitleHighlight</span>
            </h2>
            <SkeletonBlock Height="14rem" />
        </section>
    }
    else if (_testimonials is { Count: > 0 })
    {
        <section class="page home-section section-story" aria-labelledby="stories-title">
            <h2 id="stories-title" class="section-title">
                @HomeRes.TestimonialsTitle <span class="text-volt">@HomeRes.TestimonialsTitleHighlight</span>
            </h2>
            @* A swipeable row on phones, so keyboard users can scroll it too (focusable region). *@
            <div class="testimonials-grid" role="region" tabindex="0" aria-labelledby="stories-title">
                @foreach (var testimonial in _testimonials)
                {
                    <TestimonialCard Testimonial="testimonial" @key="testimonial.Id" />
                }
            </div>
        </section>
    }

    @if (_blogLoading)
    {
        <section class="page home-section section-blog" aria-labelledby="blog-title">
            <h2 id="blog-title" class="section-title">
                @HomeRes.BlogTitle <span class="text-volt">@HomeRes.BlogTitleHighlight</span>
            </h2>
            <div class="blog-grid">
                <SkeletonBlock Height="22rem" />
                <SkeletonBlock Height="22rem" />
                <SkeletonBlock Height="22rem" />
            </div>
        </section>
    }
    else if (_blogSummaries is { Count: > 0 })
    {
        <section class="page home-section section-blog" aria-labelledby="blog-title">
            <div class="section-head">
                <h2 id="blog-title" class="section-title">
                    @HomeRes.BlogTitle <span class="text-volt">@HomeRes.BlogTitleHighlight</span>
                </h2>
                <a class="section-link" href="/blog">
                    @HomeRes.BlogSeeAll <span class="bi bi-arrow-right" aria-hidden="true"></span>
                </a>
            </div>
            <div class="blog-grid">
                @foreach (var article in _blogSummaries)
                {
                    <BlogCard Article="article" @key="article.Id" />
                }
            </div>
        </section>
    }

    <section class="page home-section section-cta" aria-labelledby="cta-title">
        <div class="cta-card">
            <h2 id="cta-title" class="cta-title">
                @HomeRes.CtaTitle <span class="text-volt">@HomeRes.CtaTitleHighlight</span>
            </h2>
            <p class="cta-text">@HomeRes.CtaText</p>
            <a class="btn-cta btn-cta--large" href="/register">
                @HomeRes.CtaButton <span class="bi bi-arrow-right" aria-hidden="true"></span>
            </a>
        </div>
    </section>
}

@code {
    /// <summary>Today's workout, the training numbers, the member's programmes and recommendations.</summary>
    private RenderFragment StudentDashboard => __builder =>
    {
        var dashboard = _dashboard;

        @if (dashboard?.Today is { } plan)
        {
            <section class="today-plan card-surface" aria-labelledby="today-title">
                <CourseCover ImageUrl="@plan.CoverImageUrl" Eager="true" />
                <div class="card-surface__body today-plan__body">
                    <span class="chip chip--lime today-plan__eyebrow">
                        <span class="bi bi-calendar-check" aria-hidden="true"></span> @HomeRes.TodayPlanTitle
                    </span>
                    <h2 id="today-title" class="today-plan__lesson">@plan.LessonTitle</h2>
                    <p class="today-plan__course">
                        @plan.CourseTitle
                        @if (plan.DurationMinutes is { } minutes)
                        {
                            <span class="today-plan__minutes">
                                <span class="bi bi-stopwatch" aria-hidden="true"></span> @minutes @CourseRes.MinutesShort
                            </span>
                        }
                    </p>
                    <div class="today-plan__footer">
                        <div class="today-plan__progress">
                            <ProgressRing Value="@PercentDone(plan)" Size="48"
                                          AriaLabel="@string.Format(HomeRes.TodayPlanProgressFormat, plan.CompletedLessons, plan.TotalLessons)" />
                            <span>@string.Format(HomeRes.TodayPlanProgressFormat, plan.CompletedLessons, plan.TotalLessons)</span>
                        </div>
                        <a class="btn-cta today-plan__cta" href="/lessons/@plan.LessonId">
                            @HomeRes.TodayPlanContinue <span class="bi bi-play-fill" aria-hidden="true"></span>
                        </a>
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="today-plan today-plan--empty card-surface" aria-label="@HomeRes.TodayPlanTitle">
                <EmptyState Icon="bi-calendar-plus" Title="@HomeRes.TodayPlanTitle" Text="@HomeRes.TodayPlanEmpty"
                            ActionHref="/courses" ActionLabel="@HomeRes.DashboardBrowseCourses" />
            </section>
        }

        @if (dashboard?.Stats is { } stats)
        {
            <section class="dashboard-stats" aria-label="@HomeRes.StatsAriaLabel">
                <StatTile Value="@Number(stats.WorkoutsCompleted)" Label="@ProfileRes.WorkoutsCompleted" Icon="bi-check2-circle" />
                <StatTile Value="@Number(stats.MinutesTrained)" Label="@ProfileRes.MinutesTrained" Icon="bi-stopwatch" />
                <StatTile Value="@Number(stats.CurrentStreak)" Label="@HomeRes.StatsStreakDays" Icon="bi-fire" />
                <StatTile Value="@Number(dashboard.EnrolledCount)" Label="@HomeRes.DashboardContinueLearning" Icon="bi-collection-play" />
            </section>
        }

        @if (dashboard is { EnrolledCourses.Count: > 0 })
        {
            <section class="dashboard-section" aria-labelledby="programmes-title">
                <h2 id="programmes-title" class="dashboard-section__title">@HomeRes.DashboardContinueLearning</h2>
                <div class="grid-auto dashboard-grid">
                    @foreach (var course in dashboard.EnrolledCourses)
                    {
                        <CourseCard Course="course" Compact="true" @key="course.Id" />
                    }
                </div>
            </section>
        }

        @if (dashboard is { RecommendedCourses.Count: > 0 })
        {
            <section class="dashboard-section" aria-labelledby="recommended-title">
                <h2 id="recommended-title" class="dashboard-section__title">@HomeRes.RecommendedTitle</h2>
                <div class="grid-auto dashboard-grid">
                    @foreach (var course in dashboard.RecommendedCourses)
                    {
                        <CourseCard Course="course" Compact="true" @key="course.Id" />
                    }
                </div>
            </section>
        }
    };
}
