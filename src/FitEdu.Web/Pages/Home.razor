@page "/"

<PageTitle>@HomeRes.PageTitle</PageTitle>
@* The default description (hero subtitle) and share image are the home ones. *@
<SeoHead Title="@HomeRes.PageTitle" CanonicalUrl="/" />

@if (_isAuthenticated)
{
    <div class="authenticated-home">
        <h1>@string.Format(HomeRes.WelcomeUser, _authenticatedUserName)</h1>

        <AuthorizeView Roles="Student">
            @* Continue learning — the student's enrolled courses *@
            <section class="dashboard-section">
                <h2 class="h4">@HomeRes.DashboardContinueLearning</h2>
                @if (_coursesLoading)
                {
                    <SkeletonBlock Rows="2" Height="5rem" Gap="1rem" />
                }
                else if (_enrolledCourses is { Count: > 0 })
                {
                    <div class="dashboard-course-grid">
                        @foreach (var course in _enrolledCourses)
                        {
                            <a class="dashboard-course-card" href="/courses/@course.Id" @key="course.Id">
                                <span class="dashboard-course-title">@course.Title</span>
                                <span class="dashboard-course-meta">@string.Format(CourseRes.LessonsCountFormat, course.TotalLessons)</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="text-light-muted">@HomeRes.DashboardNoEnrollments</p>
                    <a href="/courses" class="btn-cta">@HomeRes.DashboardBrowseCourses</a>
                }
            </section>

            @* Explore — shortcuts to the main student areas *@
            <section class="dashboard-section">
                <h2 class="h4">@HomeRes.DashboardExplore</h2>
                <div class="dashboard-tiles">
                    <a class="dashboard-tile" href="/courses"><span class="bi bi-book" aria-hidden="true"></span> @NavMenuRes.Courses</a>
                    <a class="dashboard-tile" href="/assessments"><span class="bi bi-list-check" aria-hidden="true"></span> @NavMenuRes.Assessments</a>
                    <a class="dashboard-tile" href="/my-certificates"><span class="bi bi-award" aria-hidden="true"></span> @NavMenuRes.Certificates</a>
                    <a class="dashboard-tile" href="/blog"><span class="bi bi-newspaper" aria-hidden="true"></span> @NavMenuRes.Blog</a>
                    <a class="dashboard-tile" href="/pricing"><span class="bi bi-credit-card" aria-hidden="true"></span> @NavMenuRes.Pricing</a>
                </div>
            </section>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <p>@((MarkupString)HomeRes.AuthenticatedMessage)</p>
            <section class="dashboard-section">
                <h2 class="h4">@HomeRes.DashboardExplore</h2>
                <div class="dashboard-tiles">
                    <a class="dashboard-tile" href="/admin/users"><span class="bi bi-people" aria-hidden="true"></span> @NavMenuRes.Users</a>
                    <a class="dashboard-tile" href="/admin/courses"><span class="bi bi-book" aria-hidden="true"></span> @NavMenuRes.Courses</a>
                    <a class="dashboard-tile" href="/admin/analytics"><span class="bi bi-bar-chart" aria-hidden="true"></span> @NavMenuRes.Analytics</a>
                    <a class="dashboard-tile" href="/admin/blog"><span class="bi bi-newspaper" aria-hidden="true"></span> @NavMenuRes.Blog</a>
                </div>
            </section>
        </AuthorizeView>
    </div>
}
else
{
        <!-- Hero Section -->
        <section class="hero-section" style="@heroBackgroundStyle">
            <div class="hero-bg-overlay"></div>
            
            <div class="container hero-content">
                <div class="hero-text">
                    <h1 class="hero-title">
                        @HomeRes.HeroTitleLine1<br>
                        <span class="text-gradient">@HomeRes.HeroTitleLine2</span>
                    </h1>
                    <p class="hero-subtitle">
                        @HomeRes.HeroSubtitle
                    </p>
                    <div class="hero-cta">
                        <button class="btn-cta" @onclick="NavigateToRegister">
                            @HomeRes.HeroCtaButton
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="scroll-indicator">
                <div class="scroll-mouse">
                    <div class="scroll-dot"></div>
                </div>
            </div>
        </section>

        <!-- Testimonials Section -->
        @if (_testimonialsLoading)
        {
            <section class="section section-story">
                <div class="container">
                    <h2 class="section-title">
                        @HomeRes.TestimonialsTitle <span class="text-gradient">@HomeRes.TestimonialsTitleHighlight</span>
                    </h2>
                    <div class="story-card">
                        <div class="placeholder-glow">
                            <span class="placeholder col-10 mb-2" style="height:1.2rem;display:block;"></span>
                            <span class="placeholder col-8 mb-2" style="height:1rem;display:block;"></span>
                            <span class="placeholder col-4" style="height:1rem;display:block;"></span>
                        </div>
                    </div>
                </div>
            </section>
        }
        else if (_testimonials is { Count: > 0 })
        {
            <section class="section section-story">
                <div class="container">
                    <h2 class="section-title">
                        @HomeRes.TestimonialsTitle <span class="text-gradient">@HomeRes.TestimonialsTitleHighlight</span>
                    </h2>

                    <div class="testimonials-grid">
                        @foreach (var t in _testimonials)
                        {
                            <div class="story-card" @key="t.Id">
                                <div class="quote-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path>
                                        <path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path>
                                    </svg>
                                </div>

                                <blockquote>«@t.QuoteText»</blockquote>

                                <div class="author">
                                    <div class="author-avatar">
                                        @if (!string.IsNullOrEmpty(t.AvatarUrl))
                                        {
                                            <img src="@t.AvatarUrl" alt="@t.FullName"
                                                 style="width:100%;height:100%;object-fit:cover;border-radius:50%;"
                                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                            <span class="text-gradient" style="display:none;">@TestimonialInitials(t.FullName)</span>
                                        }
                                        else
                                        {
                                            <span class="text-gradient">@TestimonialInitials(t.FullName)</span>
                                        }
                                    </div>
                                    <div class="author-info">
                                        <p class="author-name">@t.FullName</p>
                                        @if (!string.IsNullOrEmpty(t.RoleOrTitle) || !string.IsNullOrEmpty(t.CompanyOrContext))
                                        {
                                            <p class="author-title">
                                                @t.RoleOrTitle
                                                @if (!string.IsNullOrEmpty(t.RoleOrTitle) && !string.IsNullOrEmpty(t.CompanyOrContext))
                                                {
                                                    <span> · </span>
                                                }
                                                @t.CompanyOrContext
                                            </p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- Blog Section -->
        @if (_blogLoading)
        {
            <section class="section section-blog">
                <div class="container">
                    <h2 class="section-title">@HomeRes.BlogTitle <span class="text-gradient">@HomeRes.BlogTitleHighlight</span></h2>
                    <div class="blog-grid">
                        <div class="blog-card blog-card-skeleton"></div>
                        <div class="blog-card blog-card-skeleton"></div>
                        <div class="blog-card blog-card-skeleton"></div>
                    </div>
                </div>
            </section>
        }
        else if (_blogSummaries is { Count: > 0 })
        {
            <section class="section section-blog">
                <div class="container">
                    <h2 class="section-title">@HomeRes.BlogTitle <span class="text-gradient">@HomeRes.BlogTitleHighlight</span></h2>
                    <div class="blog-grid">
                        @foreach (var article in _blogSummaries)
                        {
                            <div class="blog-card" @key="article.Id">
                                @if (!string.IsNullOrWhiteSpace(article.CoverImageUrl))
                                {
                                    <div class="blog-card-cover">
                                        <img src="@article.CoverImageUrl" alt="@article.Title" />
                                    </div>
                                }
                                else
                                {
                                    <div class="blog-card-cover blog-card-cover-placeholder"></div>
                                }
                                @if (article.Tags.Length > 0)
                                {
                                    <div class="blog-card-tags">
                                        @foreach (var tag in article.Tags)
                                        {
                                            <span class="blog-tag">@tag</span>
                                        }
                                    </div>
                                }
                                <h3 class="blog-card-title">@article.Title</h3>
                                <p class="blog-card-summary">@article.Summary</p>
                                <div class="blog-card-meta">
                                    <span>@article.AuthorName</span>
                                    @if (article.PublishedAt.HasValue)
                                    {
                                        <span>@article.PublishedAt.Value.ToLocalTime().ToString("d")</span>
                                    }
                                </div>
                                <a href="/blog/@article.Slug" class="btn-cta blog-card-cta">@HomeRes.BlogReadMore</a>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- CTA Section -->
        <section class="section section-cta">
            <div class="cta-glow"></div>
            
            <div class="container">
                <div class="cta-card">
                    <h2 class="cta-title">
                        @HomeRes.CtaTitle <span class="text-gradient">@HomeRes.CtaTitleHighlight</span>
                    </h2>
                    <p class="cta-text">
                        @HomeRes.CtaText
                    </p>
                    <button class="btn-cta btn-cta-large" @onclick="NavigateToRegister">
                        @HomeRes.CtaButton
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"></path>
                            <path d="m12 5 7 7-7 7"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </section>
}

