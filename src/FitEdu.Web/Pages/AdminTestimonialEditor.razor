@page "/admin/testimonials/new"
@page "/admin/testimonials/{Id:guid}"
@attribute [Authorize(Roles = "Admin")]

<AppPageTitle Text="@(_isEditMode ? AdminRes.EditTestimonial : AdminRes.NewTestimonial)" />

<div class="admin-editor admin-editor--narrow">
    <header class="section-head">
        <h1>@(_isEditMode ? AdminRes.EditTestimonial : AdminRes.NewTestimonial)</h1>
    </header>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <UnsavedChangesGuard IsDirty="_isDirty" />

    <div class="row g-3" @oninput="MarkDirty" @onchange="MarkDirty">

        <div class="col-12">
            <label class="form-label" for="t-fullname">@AdminRes.FieldFullName <span class="text-danger" aria-hidden="true">*</span></label>
            <input id="t-fullname" type="text" class="form-control" @bind="_fullName" maxlength="150"
                   placeholder="@AdminRes.TestimonialNamePlaceholder" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="t-role">@AdminRes.FieldRoleTitle</label>
            <input id="t-role" type="text" class="form-control" @bind="_roleOrTitle" maxlength="150"
                   placeholder="@AdminRes.TestimonialRolePlaceholder" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="t-role-el">@AdminRes.FieldRoleTitleEl</label>
            <input id="t-role-el" type="text" class="form-control" @bind="_roleOrTitleEl" maxlength="150" lang="el" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="t-company">@AdminRes.FieldCompanyContext</label>
            <input id="t-company" type="text" class="form-control" @bind="_companyOrContext" maxlength="150"
                   placeholder="@AdminRes.TestimonialContextPlaceholder" />
        </div>

        <div class="col-12">
            <label class="form-label" for="t-quote">@AdminRes.FieldQuote <span class="text-danger" aria-hidden="true">*</span></label>
            <textarea id="t-quote" class="form-control" rows="4" @bind="_quoteText" maxlength="1000"
                      placeholder="@AdminRes.TestimonialQuotePlaceholder"></textarea>
            <div class="form-text">@(_quoteText?.Length ?? 0) / 1000</div>
        </div>

        <div class="col-12">
            <label class="form-label" for="t-quote-el">@AdminRes.FieldQuoteEl</label>
            <textarea id="t-quote-el" class="form-control" rows="4" @bind="_quoteTextEl" maxlength="1000" lang="el"></textarea>
            <div class="form-text">@_quoteTextEl.Length / 1000</div>
        </div>

        <div class="col-md-4">
            <label class="form-label" for="t-order">@AdminRes.FieldDisplayOrder</label>
            <input id="t-order" type="number" class="form-control" @bind="_displayOrder" min="1" />
            <div class="form-text">@AdminRes.DisplayOrderHint</div>
        </div>

        <div class="col-md-8 align-self-end">
            <div class="form-check mb-2">
                <input type="checkbox" class="form-check-input" id="isActive" @bind="_isActive" />
                <label class="form-check-label" for="isActive">@AdminRes.FieldActiveLandingLabel</label>
            </div>
        </div>

        <!-- Avatar section — only shown in edit mode -->
        @if (_isEditMode)
        {
            <div class="col-12">
                <hr class="my-2" />
                <label class="form-label" for="t-avatar">@AdminRes.FieldAvatarPhoto</label>

                @if (!string.IsNullOrEmpty(_avatarPreviewUrl))
                {
                    <div class="mb-2 d-flex flex-wrap align-items-center gap-3">
                        <img src="@_avatarPreviewUrl" alt="@AdminRes.AvatarPreviewAlt" class="avatar-preview" width="80" height="80" />
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveAvatar"
                                disabled="@_isBusy">@AdminRes.Remove</button>
                    </div>
                }
                else
                {
                    <div class="mb-2">
                        <span class="avatar-placeholder-initials">
                            @Initials
                        </span>
                    </div>
                }

                <FilePicker @ref="_avatarPicker" Id="t-avatar" OnChange="OnAvatarFileSelected" Accept="image/*" />
                <div class="form-text">@AdminRes.AvatarHint</div>
            </div>
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info py-2">
                    @AdminRes.AvatarSaveFirstHint
                </div>
            </div>
        }

    </div>

    <div class="form-actions sticky-bottom-bar">
        <button class="btn-cta" @onclick="Save" disabled="@_isBusy">
            @if (_isBusy)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            }
            @AdminRes.Save
        </button>
        <button class="btn-cta btn-cta--ghost" @onclick="Cancel" disabled="@_isBusy">@AdminRes.Cancel</button>
    </div>
</div>
