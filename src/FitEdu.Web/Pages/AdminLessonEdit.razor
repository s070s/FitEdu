@page "/admin/lessons/{ModuleId:guid}"
@using FitEdu.Web.Shared
@attribute [Authorize(Roles = "Admin")]

<PageTitle>@AdminRes.ManageLessons</PageTitle>

<div class="admin-editor">
    <header class="section-head">
        <h1>@AdminRes.ManageLessons</h1>
        <div class="section-head__actions">
            <button type="button" class="btn-cta btn-cta--ghost" @onclick="GoBack"><span class="bi bi-arrow-left" aria-hidden="true"></span> @AdminRes.BackToCourse</button>
            <button type="button" class="btn-cta" @onclick="ShowAddLesson">@AdminRes.AddLesson</button>
        </div>
    </header>

    <DismissibleAlert Message="@message" AlertType="@messageType" OnDismiss="@(() => message = string.Empty)" />

    @if (lessons == null)
    {
        <LoadingSpinner Label="@AdminRes.Loading" />
    }
    else if (lessons.Count == 0)
    {
        <p class="text-light-muted">@AdminRes.NoLessons</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var lesson in lessons.OrderBy(l => l.SortOrder))
            {
                <div class="list-group-item" @key="lesson.Id">
                    <div class="lesson-row">
                        <div class="lesson-row__text">
                            <h2 class="lesson-row__title">@lesson.TitleEn</h2>
                            <small class="lesson-row__meta">
                                @string.Format(AdminRes.OrderFormat, lesson.SortOrder)
                                @if (lesson.DurationMinutes.HasValue)
                                {
                                    <text>@string.Format(AdminRes.MinutesFormat, lesson.DurationMinutes)</text>
                                }
                                @if (lesson.IsPublished)
                                {
                                    <StatusBadge IsActive="true"
                                                 ActiveText="@AdminRes.StatusPublished" />
                                }
                                else
                                {
                                    <StatusBadge IsActive="false"
                                                 InactiveText="@AdminRes.StatusDraft" />
                                }
                            </small>
                        </div>
                        <div class="lesson-row__actions">
                            <button class="btn btn-sm btn-primary" @onclick="() => ShowEditLesson(lesson)">@AdminRes.Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteLesson(lesson.Id)">@AdminRes.Delete</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Lesson Create/Edit Modal *@
<FormModal IsVisible="showLessonModal"
           Title="@(editingLessonId == null ? AdminRes.AddLesson : AdminRes.EditLesson)"
           Size="modal-xl"
           OnClose="CloseLessonModal">
    <Body>
        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label" for="lesson-title-en">@AdminRes.FieldTitle (EN)</label>
                <input id="lesson-title-en" class="form-control" @bind="lessonTitleEn" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label" for="lesson-title-el">@AdminRes.FieldTitle (EL)</label>
                <input id="lesson-title-el" class="form-control" lang="el" @bind="lessonTitleEl" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label" for="lesson-sort">@AdminRes.SortOrder</label>
                <input id="lesson-sort" type="number" class="form-control" @bind="lessonSortOrder" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label" for="lesson-duration">@AdminRes.DurationMinutes</label>
                <input id="lesson-duration" type="number" class="form-control" @bind="lessonDuration" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">@AdminRes.FieldContent (EN)</label>
            <QuillEditor @ref="lessonContentEditorEn" Content="@lessonContentEn" MinHeight="300px" />
        </div>

        <div class="mb-3">
            <label class="form-label">@AdminRes.FieldContent (EL)</label>
            <QuillEditor @ref="lessonContentEditorEl" Content="@lessonContentEl" MinHeight="300px" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="lesson-video-url">@AdminRes.VideoUrlLabel</label>
            <input id="lesson-video-url" class="form-control" @bind="lessonVideoUrl" placeholder="https://www.youtube.com/embed/..." />
            <small class="text-light-muted">@AdminRes.VideoUrlHint</small>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" for="lesson-pdf">@AdminRes.UploadPdf</label>
                <InputFile id="lesson-pdf" class="form-control" OnChange="OnPdfSelected" accept=".pdf" />
                @if (!string.IsNullOrEmpty(lessonPdfPath))
                {
                    <small class="text-success">@AdminRes.Current @lessonPdfPath</small>
                }
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" for="lesson-video">@AdminRes.UploadVideo</label>
                <InputFile id="lesson-video" class="form-control" OnChange="OnVideoSelected" accept="video/*" />
                @if (!string.IsNullOrEmpty(lessonVideoPath))
                {
                    <small class="text-success">@AdminRes.Current @lessonVideoPath</small>
                }
            </div>
        </div>
    </Body>
    <Footer>
        <button class="btn btn-primary" @onclick="SaveLesson" disabled="@isSaving">
            @(isSaving ? AdminRes.Saving : AdminRes.SaveLesson)
        </button>
        <button class="btn btn-secondary" @onclick="CloseLessonModal">@AdminRes.Cancel</button>
    </Footer>
</FormModal>

<ConfirmModal IsVisible="@(_pendingDeleteLessonId.HasValue)"
              Title="@AdminRes.ConfirmTitle"
              Message="@AdminRes.ConfirmDeleteLesson"
              ConfirmLabel="@AdminRes.Delete"
              CancelLabel="@AdminRes.Cancel"
              OnConfirm="ExecuteDeleteLessonAsync"
              OnCancel="@(() => _pendingDeleteLessonId = null)" />

