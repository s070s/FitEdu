@implements IDisposable

@* Sticky glass header: brand, the role's main links inline on wide screens, the trailing tools
   (search, language, notifications, avatar) and a menu button whose panel lists every link.
   On phones the BottomNav tab bar carries the main links, so the header keeps only the tools. *@
<nav class="site-header" aria-label="@GlobalRes.NavigationMenu">
    <div class="site-header__inner">
        <a class="site-brand" href="">
            <BrandMark />
            <span class="site-brand__name">FitEdu</span>
        </a>

        @if (_headerItems.Count > 0)
        {
            <ul class="site-links">
                @foreach (var item in _headerItems)
                {
                    <li>
                        <NavLink class="@HeaderLinkClass(item)" href="@item.Href" Match="@item.Match">@item.CompactLabel</NavLink>
                    </li>
                }
            </ul>
        }

        @if (TrailingContent != null)
        {
            <div class="trailing-content">
                @TrailingContent
            </div>
        }

        @if (_items.Count > 0)
        {
            <button type="button" class="@MenuToggleClass" @ref="_menuToggle"
                    @onclick="ToggleMenu" @onkeydown="HandleMenuKeyDown"
                    aria-label="@NavMenuRes.Menu" title="@NavMenuRes.Menu"
                    aria-controls="site-menu" aria-expanded="@(_menuOpen ? "true" : "false")">
                <span class="bi @(_menuOpen ? "bi-x-lg" : "bi-list")" aria-hidden="true"></span>
            </button>
        }

        @if (_menuOpen)
        {
            <div class="site-menu-backdrop" @onclick="CloseMenu"></div>
            <div id="site-menu" class="site-menu" @onkeydown="HandleMenuKeyDown">
                <ul class="site-menu__list" @onclick="CloseMenu">
                    @foreach (var item in _items)
                    {
                        <li>
                            <NavLink class="site-menu__link" href="@item.Href" Match="@item.Match">
                                <span class="bi @item.Icon site-menu__icon" aria-hidden="true"></span>
                                <span>@item.Label()</span>
                            </NavLink>
                        </li>
                    }
                </ul>
                <div class="site-menu__language">
                    <span class="site-menu__language-label">@NavMenuRes.Language</span>
                    <CultureSelector />
                </div>
            </div>
        }
    </div>
</nav>
