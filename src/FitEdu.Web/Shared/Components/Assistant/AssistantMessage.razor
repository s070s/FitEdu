@* A single chat bubble in plain text. The coach is told not to use markdown, but the small local
   model still adds bold marks and headings now and then, so its answers lose those marks here. *@
<div class="assistant-message @(Role == "user" ? "assistant-message-user" : "assistant-message-bot")">
    @(Role == "user" ? Content : RemoveMarkdownMarks(Content))
</div>

@code {
    [Parameter, EditorRequired] public string Role { get; set; } = "";
    [Parameter, EditorRequired] public string Content { get; set; } = "";
}
