@* A file input whose button and "no file chosen" text follow the page language; the browser's own
   file input always speaks the browser's language. The real input stays in the page, hidden but
   focusable, so the keyboard and the field's own <label for> still reach it. *@

<div class="file-picker">
    <InputFile id="@Id"
               class="file-picker__input visually-hidden"
               accept="@Accept"
               disabled="@Disabled"
               aria-describedby="@FileNameId"
               OnChange="HandleChangeAsync" />
    <label class="btn-cta btn-cta--ghost file-picker__button" for="@Id">
        <span class="bi bi-upload" aria-hidden="true"></span>
        <span>@GlobalRes.ChooseFile</span>
    </label>
    <span id="@FileNameId" class="file-picker__name">@(_fileName ?? GlobalRes.NoFileChosen)</span>
</div>

@code {
    /// <summary>The input's id; the field's &lt;label for&gt; and the picker button both point at it.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    /// <summary>The file types the dialog offers, as in the HTML accept attribute ("image/*", ".pdf").</summary>
    [Parameter] public string? Accept { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }

    private string? _fileName;

    private string FileNameId => $"{Id}-file-name";

    private async Task HandleChangeAsync(InputFileChangeEventArgs args)
    {
        _fileName = args.File.Name;
        await OnChange.InvokeAsync(args);
    }
}
