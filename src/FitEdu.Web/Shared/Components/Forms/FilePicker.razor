@* A file input whose button and "no file chosen" text follow the page language; the browser's own
   file input always speaks the browser's language. The real input stays in the page, hidden but
   focusable, so the keyboard and the field's own <label for> still reach it. *@

<div class="file-picker">
    <InputFile @key="_inputKey"
               id="@Id"
               class="file-picker__input visually-hidden"
               accept="@Accept"
               disabled="@Disabled"
               aria-describedby="@DescribedByIds"
               OnChange="HandleChangeAsync" />
    <label class="btn-cta btn-cta--ghost file-picker__button" for="@Id">
        <span class="bi bi-upload" aria-hidden="true"></span>
        <span>@GlobalRes.ChooseFile</span>
    </label>
    <span id="@FileNameId" class="file-picker__name">@(_fileName ?? GlobalRes.NoFileChosen)</span>
</div>

@code {
    /// <summary>The input's id; the field's &lt;label for&gt; and the picker button both point at it.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    /// <summary>The file types the dialog offers, as in the HTML accept attribute ("image/*", ".pdf").</summary>
    [Parameter] public string? Accept { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>The id of another element that describes this field, such as its error message; read after the file name.</summary>
    [Parameter] public string? DescribedBy { get; set; }

    [Parameter] public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }

    /// <summary>Raised when the choice is taken back (the dialog was cancelled after a file was chosen), so the parent drops the file it kept.</summary>
    [Parameter] public EventCallback OnCleared { get; set; }

    private string? _fileName;

    // A new key makes Blazor build a fresh input element. The browser keeps the old element's chosen
    // file, and picking the same file again would not raise a change event.
    private int _inputKey;

    private string FileNameId => $"{Id}-file-name";

    private string DescribedByIds => string.IsNullOrWhiteSpace(DescribedBy) ? FileNameId : $"{FileNameId} {DescribedBy}";

    /// <summary>
    /// Shows "no file chosen" again. The parent calls it (through @ref) when it rejects the file or
    /// removes it, so the picker never names a file the form did not keep. It also resets the input,
    /// so the same file can be chosen again.
    /// </summary>
    public void ClearFileName()
    {
        _fileName = null;
        _inputKey++;
        StateHasChanged();
    }

    private async Task HandleChangeAsync(InputFileChangeEventArgs args)
    {
        // Cancelling the dialog after a choice sends a change with no file.
        if (args.FileCount == 0)
        {
            _fileName = null;
            await OnCleared.InvokeAsync();
            return;
        }

        _fileName = args.File.Name;
        await OnChange.InvokeAsync(args);
    }
}
