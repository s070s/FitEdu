@using FitEdu.Web.Extensions
@* Catalogue card for one course: cover (photo or category icon) with the category and plan badges,
   then level, title, schedule, lessons, rating and the enrolled or locked state. The title link is
   stretched over the whole card; a locked course links to /pricing. Keeps the e2e selectors
   .course-card and a.course-card-link. *@

<article class="course-card card-surface card-surface--interactive @(IsLocked ? "course-locked" : "") @(Compact ? "course-card--compact" : "")">
    <CourseCover ImageUrl="@Course.CoverImageUrl" CategoryName="@Course.CategoryName">
        @if (Course.CategoryName is not null)
        {
            <span class="course-card__category">
                <span class="bi @CategoryIcons.For(Course.CategoryName)" aria-hidden="true"></span>
                @Course.CategoryName
            </span>
        }
        @if (Course.RequiredTier != SubscriptionTier.Free)
        {
            <span class="tier-badge course-card__tier tier-@Course.RequiredTier.ToString().ToLowerInvariant()">@Course.RequiredTier</span>
        }
    </CourseCover>

    <div class="card-surface__body course-card__body">
        <div class="course-card__chips">
            <LevelBadge Level="@Course.Level" />
            @if (ScheduleText is { } schedule)
            {
                <span class="chip">
                    <span class="bi bi-calendar-week" aria-hidden="true"></span>
                    @schedule
                </span>
            }
        </div>

        <h3 class="course-card__title">
            <a class="course-card-link" href="@Href">@Course.Title</a>
        </h3>

        @if (!Compact && !string.IsNullOrEmpty(Course.Description))
        {
            <div class="course-card__description">@((MarkupString)Course.Description)</div>
        }

        <div class="course-card__meta">
            <span class="course-card__lessons">
                <span class="bi bi-collection-play" aria-hidden="true"></span>
                @string.Format(CourseRes.LessonsCountFormat, Course.TotalLessons)
            </span>
            @if (Course.AverageRating is { } rating)
            {
                <span class="course-card__rating">
                    <StarRating Value="rating" AriaLabel="@string.Format(ReviewRes.RatingSummaryFormat, rating, Course.ReviewCount)" />
                    <span class="course-card__rating-count" aria-hidden="true">(@Course.ReviewCount)</span>
                </span>
            }
            @if (Course.IsEnrolled)
            {
                <span class="enrolled-badge">
                    <span class="bi bi-check-circle-fill" aria-hidden="true"></span> @CourseRes.Enrolled
                </span>
            }
            @if (IsLocked)
            {
                @* A visual label only: the stretched title link already leads to /pricing. *@
                <span class="locked-badge">
                    <span class="bi bi-lock-fill" aria-hidden="true"></span> @string.Format(CourseRes.UpgradeToFormat, Course.RequiredTier)
                </span>
            }
        </div>
    </div>
</article>

@code {
    private const string PricingPath = "/pricing";
    private const string CoursePathPrefix = "/courses/";

    [Parameter, EditorRequired] public CourseListItemDto Course { get; set; } = default!;

    /// <summary>True when the member's plan does not include this course: the card links to pricing.</summary>
    [Parameter] public bool IsLocked { get; set; }

    /// <summary>Hides the description (dashboard rows, "recommended" strips).</summary>
    [Parameter] public bool Compact { get; set; }

    private string Href => IsLocked ? PricingPath : CoursePathPrefix + Course.Id;

    /// <summary>"8 weeks · 3× per week", either half alone, or null when the course has neither.</summary>
    private string? ScheduleText
    {
        get
        {
            var parts = new List<string>();
            if (Course.EstimatedWeeks is { } weeks)
                parts.Add(string.Format(CourseRes.WeeksFormat, weeks));
            if (Course.SessionsPerWeek is { } sessions)
                parts.Add(string.Format(CourseRes.SessionsPerWeekFormat, sessions));

            return parts.Count == 0 ? null : string.Join(" · ", parts);
        }
    }
}
