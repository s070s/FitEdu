@* Shared prose layout of the privacy policy and the terms of use: title, date, the educational
   notice, an intro and numbered sections, with a link to the other document at the end. *@

<SeoHead Title="@Title" Description="@Intro" CanonicalUrl="@CanonicalPath" />

<div class="legal-page">
    <article class="legal-content">
        <header class="legal-header">
            <span class="eyebrow">@LegalRes.Eyebrow</span>
            <h1>@Title</h1>
            <p class="legal-updated">
                <span class="bi bi-calendar3" aria-hidden="true"></span>
                @LegalRes.LastUpdated
            </p>
        </header>

        <div class="legal-notice" role="note">
            <span class="bi bi-info-circle legal-notice__icon" aria-hidden="true"></span>
            <p>
                <strong>@LegalRes.EducationalNoticeTitle.</strong>
                @LegalRes.EducationalNotice
            </p>
        </div>

        <p class="legal-intro">@Intro</p>

        <ol class="legal-sections">
            @foreach (var section in Sections)
            {
                <li>
                    <section>
                        <h2>@section.Title</h2>
                        <p>@section.Body</p>
                    </section>
                </li>
            }
        </ol>

        <footer class="legal-footer">
            <a href="@OtherDocumentHref">@OtherDocumentTitle <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
            <a href="/"><span class="bi bi-arrow-left" aria-hidden="true"></span> @HomeRes.BackToHome</a>
        </footer>
    </article>
</div>

@code {
    /// <summary>One numbered section of the page.</summary>
    public sealed record Section(string Title, string Body);

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Intro { get; set; } = string.Empty;

    /// <summary>The page's own path, for the canonical link (e.g. "/privacy").</summary>
    [Parameter, EditorRequired] public string CanonicalPath { get; set; } = string.Empty;

    [Parameter, EditorRequired] public IReadOnlyList<Section> Sections { get; set; } = [];

    [Parameter, EditorRequired] public string OtherDocumentHref { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string OtherDocumentTitle { get; set; } = string.Empty;
}
