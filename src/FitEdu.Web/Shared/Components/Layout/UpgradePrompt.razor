@* Renders the upgrade-prompt lock block for subscription-gated features. *@

<section class="upgrade-prompt card-surface" aria-labelledby="upgrade-prompt-title">
    <div class="upgrade-icon" aria-hidden="true"><span class="bi bi-lock"></span></div>
    <span class="upgrade-prompt__plan chip chip--lime">
        <span class="bi bi-stars" aria-hidden="true"></span> @PlanName
    </span>
    <h2 id="upgrade-prompt-title" class="upgrade-prompt__title">@string.Format(PricingRes.PlanRequired, PlanName)</h2>
    <p class="upgrade-prompt__text">@Description</p>
    <a href="@PricingPath" class="btn-cta upgrade-prompt__action">
        @UpgradeButtonText <span class="bi bi-arrow-right" aria-hidden="true"></span>
    </a>
</section>

@code {
    /// <summary>The lowest plan that unlocks the feature; its name is shown in the member's language.</summary>
    [Parameter] public SubscriptionTier Tier { get; set; } = SubscriptionTier.Plus;
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string PricingPath { get; set; } = "/pricing";
    [Parameter] public string UpgradeButtonText { get; set; } = PricingRes.UpgradeNow;

    private string PlanName => TierLabels.Name(Tier);
}
