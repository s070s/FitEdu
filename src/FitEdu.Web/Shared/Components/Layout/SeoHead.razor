@inject NavigationManager Navigation

<HeadContent>
    <meta name="description" content="@_description" />

    @* Open Graph *@
    <meta property="og:site_name" content="@SiteName" />
    <meta property="og:type" content="@OgType" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@_description" />
    <meta property="og:url" content="@_canonicalUrl" />
    <meta property="og:image" content="@_imageUrl" />

    @* Twitter Card — every page has an image (the home share image by default) *@
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Title" />
    <meta name="twitter:description" content="@_description" />
    <meta name="twitter:image" content="@_imageUrl" />

    @* Canonical URL *@
    <link rel="canonical" href="@_canonicalUrl" />

    @* hreflang — language controlled by cookie, same URLs for both locales *@
    <link rel="alternate" hreflang="en" href="@_canonicalUrl" />
    <link rel="alternate" hreflang="el" href="@_canonicalUrl" />
    <link rel="alternate" hreflang="x-default" href="@_canonicalUrl" />
</HeadContent>

@code {
    private const string SiteName = "FitEdu";
    private const string DefaultImagePath = "/images/og-home.jpg";

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Falls back to the site description (the home hero subtitle) when empty.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>An absolute URL, or a site path such as "/paths" that is joined to the site address.</summary>
    [Parameter, EditorRequired] public string CanonicalUrl { get; set; } = string.Empty;

    /// <summary>An absolute URL or a site path; the home share image when empty.</summary>
    [Parameter] public string? ImageUrl { get; set; }

    [Parameter] public string OgType { get; set; } = "website";

    private string _description = string.Empty;
    private string _canonicalUrl = string.Empty;
    private string _imageUrl = string.Empty;

    protected override void OnParametersSet()
    {
        _description = string.IsNullOrWhiteSpace(Description) ? HomeRes.HeroSubtitle : Description;
        _canonicalUrl = ToAbsoluteUrl(CanonicalUrl);
        _imageUrl = ToAbsoluteUrl(string.IsNullOrWhiteSpace(ImageUrl) ? DefaultImagePath : ImageUrl);
    }

    /// <summary>Search engines and social previews need absolute URLs; site paths get the site address.</summary>
    private string ToAbsoluteUrl(string urlOrPath)
    {
        var isAbsoluteWebUrl = Uri.TryCreate(urlOrPath, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp);
        if (isAbsoluteWebUrl)
            return urlOrPath;

        // The sitemap builds its URLs from the same setting, so canonical links and the sitemap agree.
        var siteBaseUrl = Configuration[SitemapBuilder.BaseUrlSetting];
        if (string.IsNullOrWhiteSpace(siteBaseUrl))
            siteBaseUrl = Navigation.BaseUri;

        return siteBaseUrl.TrimEnd('/') + "/" + urlOrPath.TrimStart('/');
    }
}
