@* UX-7: shared site footer, rendered globally from MainLayout so authenticated
   users (and every app page) get the footer, not only the anonymous landing page.
   Phones: brand, then the link columns two by two; from 768 px four columns in one row. *@

<footer class="site-footer">
    <div class="site-footer__inner">
        <div class="site-footer__grid">
            <div class="site-footer__brand">
                <a class="site-footer__logo" href="">
                    <BrandMark Size="32" />
                    <span>@HomeRes.FooterBrand</span>
                </a>
                <p class="site-footer__tagline">@HomeRes.FooterTagline</p>
            </div>

            <nav class="site-footer__column" aria-labelledby="footer-explore">
                <h2 id="footer-explore" class="site-footer__heading">@HomeRes.FooterExplore</h2>
                <ul class="site-footer__links">
                    @foreach (var link in ExploreLinks)
                    {
                        <li><a href="@link.Href">@link.Label</a></li>
                    }
                </ul>
            </nav>

            <nav class="site-footer__column" aria-labelledby="footer-legal">
                <h2 id="footer-legal" class="site-footer__heading">@HomeRes.FooterLegal</h2>
                <ul class="site-footer__links">
                    <li><a href="/privacy">@LegalRes.PrivacyTitle</a></li>
                    <li><a href="/terms">@LegalRes.TermsTitle</a></li>
                </ul>
            </nav>

            <div class="site-footer__column">
                <h2 class="site-footer__heading">@HomeRes.FooterFollow</h2>
                <div class="site-footer__social">
                    <a href="@YoutubeUrl" class="social-link" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
                        <span class="bi bi-youtube" aria-hidden="true"></span>
                    </a>
                    <a href="@InstagramUrl" class="social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                        <span class="bi bi-instagram" aria-hidden="true"></span>
                    </a>
                </div>
            </div>
        </div>

        <div class="site-footer__bottom">
            <p>@HomeRes.FooterCopyright</p>
            <p>@HomeRes.FooterAuthorName · @HomeRes.FooterAuthorRole</p>
        </div>
    </div>
</footer>

@code {
    private sealed record FooterLink(string Href, string Label);

    private static IReadOnlyList<FooterLink> ExploreLinks =>
    [
        new("/courses", NavMenuRes.Courses),
        new("/exercises", NavMenuRes.Exercises),
        new("/paths", NavMenuRes.Paths),
        new("/pricing", NavMenuRes.Pricing),
        new("/blog", NavMenuRes.Blog)
    ];

    private string InstagramUrl => Configuration["Social:Instagram"] ?? "https://instagram.com/yourprofile";
    private string YoutubeUrl => Configuration["Social:Youtube"] ?? "https://youtube.com";
}
