@* Pulse (ECG trace) loading indicator. Reusable across the app; Size, Label and Overlay are unchanged. *@
<div class="@CssClass" role="status" aria-label="@(string.IsNullOrEmpty(Label) ? GlobalRes.Loading : Label)">
    <div class="pulse-loader__container">
        <svg class="pulse-loader__svg" viewBox="0 0 120 40" xmlns="http://www.w3.org/2000/svg"
             aria-hidden="true" focusable="false">
            <path class="pulse-loader__track" d="M0 20 H120" />
            <path class="pulse-loader__line" d="M0 20 H30 L38 20 L44 6 L52 34 L58 20 H120" pathLength="100" />
        </svg>

        @if (!string.IsNullOrEmpty(Label))
        {
            <span class="pulse-loader__label">@Label</span>
        }
    </div>
</div>

@code {
    /// <summary>Visual size of the loader.</summary>
    [Parameter] public SpinnerSize Size { get; set; } = SpinnerSize.Medium;

    /// <summary>Optional label displayed below the trace.</summary>
    [Parameter] public string Label { get; set; } = string.Empty;

    /// <summary>
    /// When true the loader fills the nearest positioned ancestor
    /// with a translucent overlay so it blocks interaction beneath it.
    /// </summary>
    [Parameter] public bool Overlay { get; set; }

    private string CssClass =>
        $"pulse-loader pulse-loader--{Size.ToString().ToLowerInvariant()}{(Overlay ? " pulse-loader--overlay" : "")}";

    public enum SpinnerSize { Small, Medium, Large }
}
