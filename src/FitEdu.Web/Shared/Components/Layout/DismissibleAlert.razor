@* Renders a dismissible Bootstrap alert. Renders nothing when Message is empty. *@

@if (!string.IsNullOrEmpty(Message))
{
    <div id="@Id" class="alert alert-@AlertType @(Dismissible ? "alert-dismissible" : "") mt-3" role="alert">
        @Message
        @if (Dismissible)
        {
            <button type="button" class="btn-close" @onclick="OnDismiss" aria-label="@DismissLabel"></button>
        }
    </div>
}

@code {
    /// <summary>The id of the alert element, so a field can point at it with aria-describedby.</summary>
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string AlertType { get; set; } = "info";
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public bool Dismissible { get; set; } = true;
    [Parameter] public string DismissLabel { get; set; } = GlobalRes.Close;
}
