@* One centred status card for a page that has a single message: not found, account disabled,
   certificate checks. The icon circle carries the tone; the title is the page's h1. *@

<section class="status-panel status-panel--@ToneClass card-surface" aria-labelledby="@HeadingId">
    <span class="status-panel__icon" aria-hidden="true"><span class="bi @Icon"></span></span>
    @if (!string.IsNullOrWhiteSpace(Eyebrow))
    {
        <span class="eyebrow">@Eyebrow</span>
    }
    <h1 id="@HeadingId" class="status-panel__title">@Title</h1>
    @if (!string.IsNullOrWhiteSpace(Lead))
    {
        <p class="status-panel__lead">@Lead</p>
    }
    @ChildContent
    @if (Actions is not null)
    {
        <div class="status-panel__actions">@Actions</div>
    }
</section>

@code {
    /// <summary>Colour of the icon circle.</summary>
    public enum StatusTone
    {
        Success,
        Danger,
        Neutral
    }

    private const string HeadingId = "status-panel-title";

    /// <summary>Bootstrap Icons class shown in the circle, e.g. "bi-patch-check-fill".</summary>
    [Parameter] public string Icon { get; set; } = "bi-info-circle";

    [Parameter] public StatusTone Tone { get; set; } = StatusTone.Neutral;

    /// <summary>Small uppercase line above the title.</summary>
    [Parameter] public string? Eyebrow { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Lead { get; set; }

    /// <summary>Extra content under the lead, such as a details list.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Buttons or links; they stack on phones and sit in one row from 576 px.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    private string ToneClass => Tone.ToString().ToLowerInvariant();
}
