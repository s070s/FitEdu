@inject IHttpContextAccessor HttpContextAccessor
@{
    var cultureFeature = HttpContextAccessor.HttpContext?.Features
        .Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    var htmlLang = cultureFeature?.RequestCulture.UICulture.TwoLetterISOLanguageName ?? "en";
}
<!DOCTYPE html>
<html lang="@htmlLang">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0E1116" />
    <title>FitEdu</title>
    <base href="/" />
    <HeadOutlet />

    <!-- Preconnect hint (Bootstrap Icons and Quill come from jsDelivr) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    <!-- Critical CSS (needed for first paint) -->
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="css/shared-components.css" />
    <!-- Bootstrap Icons used in NavMenu (above fold) — load synchronously to prevent
         icon FOIT from changing navbar height and causing a layout shift on the hero. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <!-- Brand icons: the SVG dumbbell mark, a PNG fallback, the home-screen icon and the web manifest -->
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="favicon.png" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link href="FitEdu.Web.styles.css" rel="stylesheet" />

    <!-- Non-critical CSS deferred until after first paint. media="print" defers application
         without blocking render; js/lazy-css.js (external, not inline — SEC-5/CSP) flips
         media back to "all" once each stylesheet has loaded (handles either load order). -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"
          media="print" data-lazy-css />
    <script defer src="js/lazy-css.js"></script>
</head>

<body>
    @* prerender: true renders static HTML on the server first (better SEO and faster first
       paint for public marketing/blog pages). Components must guard OnInitializedAsync so the
       pre-render + interactive-reconnect passes do not duplicate API calls. *@
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: true))" />

    <div id="blazor-error-ui" data-nosnippet>
        @GlobalRes.UnhandledError
        <a href="." class="reload">@GlobalRes.Reload</a>
        <span class="dismiss" role="button" title="@GlobalRes.Close" aria-label="@GlobalRes.Close"><span class="bi bi-x-lg" aria-hidden="true"></span></span>
    </div>

    <!-- Defer heavy third-party JS -->
    <script defer src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script defer src="js/quill-interop.js"></script>
    <script defer src="js/chat-interop.js"></script>
    <script defer src="js/input-interop.js"></script>
    <script defer src="js/webrtc-interop.js"></script>
    <script defer src="js/cert-interop.js"></script>
    <script defer src="js/modal-interop.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
