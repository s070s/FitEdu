@inject IHttpContextAccessor HttpContextAccessor
@{
    var cultureFeature = HttpContextAccessor.HttpContext?.Features
        .Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    var htmlLang = cultureFeature?.RequestCulture.UICulture.TwoLetterISOLanguageName ?? "en";
}
<!DOCTYPE html>
<html lang="@htmlLang">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0E1116" />
    <base href="/" />
    @* Same render mode as Routes: a static outlet keeps the first page's title after in-app navigation. *@
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: true))" />

    <!-- Preconnect hint (Quill comes from jsDelivr) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    <!-- Critical CSS (needed for first paint) -->
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <!-- Asset URLs are fingerprinted (cached for good, changed file = new URL). -->
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/shared-components.css"]" />
    <!-- Bootstrap Icons used in NavMenu (above fold) — load synchronously to prevent
         icon FOIT from changing navbar height and causing a layout shift on the hero. -->
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/font/bootstrap-icons.min.css"]" />
    <!-- Same URL (incl. ?query) as the font-face rule in bootstrap-icons.min.css, so the browser reuses this fetch. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/lib/bootstrap-icons/font/fonts/bootstrap-icons.woff2?dd67030699838ea613ee6dbda90effa6" />
    <!-- Brand icons: the SVG dumbbell mark, a PNG fallback, the home-screen icon and the web manifest -->
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="favicon.png" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link href="@Assets["FitEdu.Web.styles.css"]" rel="stylesheet" />

    <!-- Non-critical CSS deferred until after first paint. media="print" defers application
         without blocking render; js/lazy-css.js (external, not inline — SEC-5/CSP) flips
         media back to "all" once each stylesheet has loaded (handles either load order). -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"
          media="print" data-lazy-css />
    <script defer src="@Assets["js/lazy-css.js"]"></script>
</head>

<body>
    @* prerender: true renders static HTML on the server first (better SEO and faster first
       paint for public marketing/blog pages). Components must guard OnInitializedAsync so the
       pre-render + interactive-reconnect passes do not duplicate API calls. *@
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: true))" />

    <div id="blazor-error-ui" data-nosnippet>
        @GlobalRes.UnhandledError
        <a href="." class="reload">@GlobalRes.Reload</a>
        <button type="button" class="dismiss" title="@GlobalRes.Close" aria-label="@GlobalRes.Close"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
    </div>

    <!-- Defer heavy third-party JS -->
    <script defer src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script defer src="@Assets["js/quill-interop.js"]"></script>
    <script defer src="@Assets["js/chat-interop.js"]"></script>
    <script defer src="@Assets["js/input-interop.js"]"></script>
    <script defer src="@Assets["js/webrtc-interop.js"]"></script>
    <script defer src="@Assets["js/cert-interop.js"]"></script>
    <script defer src="@Assets["js/modal-interop.js"]"></script>
    <script defer src="@Assets["js/scroll-regions.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
